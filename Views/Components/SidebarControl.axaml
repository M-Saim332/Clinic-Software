<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClinicSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="224" d:DesignHeight="780"
             x:Class="ClinicSystem.UI.Views.Components.SidebarControl"
             x:DataType="vm:MainWindowViewModel"
             Width="240"
             Background="{DynamicResource ThemeSidebarBackgroundBrush}">

    <UserControl.Styles>

        <!-- ── Segmented Switcher ────────────────────────────────────── -->
        <Style Selector="Button.segmentedBtn">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="Foreground"         Value="#4B5563"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Padding"            Value="0,9"/>
            <Setter Property="CornerRadius"       Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"  Value="Stretch"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.segmentedBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="#EFF6FF"/>
            <Setter Property="TextElement.Foreground" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.segmentedBtn materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.segmentedBtn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.segmentedBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>

        <!-- Clinic active pill -->
        <Style Selector="Button.segmentedBtn.clinicActive">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.segmentedBtn.clinicActive /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
            <Setter Property="BoxShadow"              Value="0 2 8 0 #3004A3F8"/>
        </Style>
        <Style Selector="Button.segmentedBtn.clinicActive materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.segmentedBtn.clinicActive TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Pharma active pill -->
        <Style Selector="Button.segmentedBtn.pharmaActive">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.segmentedBtn.pharmaActive /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
            <Setter Property="BoxShadow"              Value="0 2 8 0 #3004A3F8"/>
        </Style>
        <Style Selector="Button.segmentedBtn.pharmaActive materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.segmentedBtn.pharmaActive TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ── Nav Buttons ──────────────────────────────────────────── -->
        <Style Selector="Button.navbtn">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="Foreground"         Value="{DynamicResource ThemeSidebarForegroundBrush}"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="CornerRadius"       Value="8"/>
            <Setter Property="Padding"            Value="12,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"           Value="13.5"/>
            <Setter Property="FontWeight"         Value="Medium"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.navbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.navbtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.navbtn:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.navbtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.navbtn.active">
            <Setter Property="Background" Value="{DynamicResource ThemeSidebarActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSidebarActiveForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.navbtn.active /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource ThemeSidebarActiveBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSidebarActiveForegroundBrush}"/>
        </Style>

        <!-- Icon color inherits from button foreground -->
        <Style Selector="Button.navbtn materialIcons|MaterialIcon">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.navbtn.active materialIcons|MaterialIcon">
            <Setter Property="Opacity" Value="1"/>
        </Style>

    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ── Logo / Brand ─────────────────────────────────────── -->
            <Border Grid.Row="0" Padding="18,16,18,14"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="14">

                    <!-- Logo row -->
                    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                        <!-- Gradient icon badge -->
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource ThemePrimaryBrush}">
                            <materialIcons:MaterialIcon Kind="MedicalBag" Width="20" Height="20"
                                      Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding DynamicClinicName, FallbackValue='DR ASIF\'S CLINIC'}" FontSize="15.5" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeSidebarForegroundBrush}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Management System" FontSize="10.5"
                                       Foreground="{DynamicResource ThemeSidebarSubtleForegroundBrush}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Segmented Switcher ── -->
                    <Border IsVisible="{Binding CanSwitchSystemMode}"
                            Background="{DynamicResource ThemeSidebarSwitcherBgBrush}"
                            CornerRadius="9" Padding="3"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,*">

                            <!-- Clinic -->
                            <Button Grid.Column="0"
                                    Command="{Binding SwitchToClinicalCommand}"
                                    Classes="segmentedBtn"
                                    Classes.clinicActive="{Binding IsClinicalMode}">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Stethoscope" Width="15" Height="15"/>
                                    <TextBlock Text="Clinic" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Pharma -->
                            <Button Grid.Column="1"
                                    Command="{Binding SwitchToPharmaCommand}"
                                    Classes="segmentedBtn"
                                    Classes.pharmaActive="{Binding IsPharmaMode}">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Pill" Width="15" Height="15"/>
                                    <TextBlock Text="Pharma" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Navigation ───────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2" Margin="10,14,10,40" VerticalAlignment="Top">

                    <!-- MAIN -->
                    <Button Command="{Binding ShowDashboardCommand}"
                            Classes="navbtn" Classes.active="{Binding IsDashboardActive}"
                            IsVisible="{Binding CanAccessDashboard}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- MANAGEMENT section label -->
                    <TextBlock IsVisible="{Binding HasManagementAccess}"
                               Text="MANAGEMENT"
                               FontSize="10" FontWeight="Bold" LetterSpacing="1.8"
                               Foreground="{DynamicResource ThemeSidebarSubtleForegroundBrush}"
                               Margin="12,16,0,6"
                               FontFamily="{DynamicResource FontLexend}"
                               Opacity="0.7"/>

                    <Button Command="{Binding ShowAppointmentsCommand}"
                            Classes="navbtn" Classes.active="{Binding IsAppointmentsActive}"
                            IsVisible="{Binding CanAccessAppointments}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="CalendarMonth" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Appointments" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowPatientsCommand}"
                            Classes="navbtn" Classes.active="{Binding IsPatientsActive}"
                            IsVisible="{Binding CanAccessPatients}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="AccountHeartOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Patients" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowProductsCommand}"
                            Classes="navbtn" Classes.active="{Binding IsProductsActive}"
                            IsVisible="{Binding CanAccessProducts}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="PillMultiple" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductNavigationLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowCompaniesCommand}"
                            Classes="navbtn" Classes.active="{Binding IsCompaniesActive}"
                            IsVisible="{Binding CanAccessCompanies}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="OfficeBuildingOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Companies" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSuppliersCommand}"
                            Classes="navbtn" Classes.active="{Binding IsSuppliersActive}"
                            IsVisible="{Binding CanAccessSuppliers}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="TruckDeliveryOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Suppliers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>



                    <!-- TRANSACTIONS section label -->
                    <TextBlock IsVisible="{Binding HasTransactionsAccess}"
                               Text="TRANSACTIONS"
                               FontSize="10" FontWeight="Bold" LetterSpacing="1.8"
                               Foreground="{DynamicResource ThemeSidebarSubtleForegroundBrush}"
                               Margin="12,16,0,6"
                               FontFamily="{DynamicResource FontLexend}"
                               Opacity="0.7"/>

                    <Button Command="{Binding ShowPurchasesCommand}"
                            Classes="navbtn" Classes.active="{Binding IsPurchasesActive}"
                            IsVisible="{Binding CanAccessPurchases}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="CartOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Purchases" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSalesCommand}"
                            Classes="navbtn" Classes.active="{Binding IsSalesActive}"
                            IsVisible="{Binding CanAccessSales}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ReceiptOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Sales &amp; Billing" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowReturnsCommand}"
                            Classes="navbtn" Classes.active="{Binding IsReturnsActive}"
                            IsVisible="{Binding CanAccessReturns}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ArrowULeftTop" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Returns" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ANALYSIS section label -->
                    <TextBlock IsVisible="{Binding HasAnalysisAccess}"
                               Text="ANALYSIS"
                               FontSize="10" FontWeight="Bold" LetterSpacing="1.8"
                               Foreground="{DynamicResource ThemeSidebarSubtleForegroundBrush}"
                               Margin="12,16,0,6"
                               FontFamily="{DynamicResource FontLexend}"
                               Opacity="0.7"/>

                    <Button Command="{Binding ShowInventoryCommand}"
                            Classes="navbtn" Classes.active="{Binding IsInventoryActive}"
                            IsVisible="{Binding CanAccessInventory}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Inventory" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowReportsCommand}"
                            Classes="navbtn" Classes.active="{Binding IsReportsActive}"
                            IsVisible="{Binding CanAccessReports}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ChartLineVariant" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Fixed Bottom: Profile ─────────────────── -->
            <StackPanel Grid.Row="2" Spacing="2" Margin="10,0,10,16">
                <Border Height="1" Background="{DynamicResource BrushLine}" Margin="6,0,6,10"
                        IsVisible="{Binding HasUserSettingsAccess}"/>

                <Button Command="{Binding ShowProfileCommand}"
                        Classes="navbtn" Classes.active="{Binding IsProfileActive}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="AccountCircleOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                        <TextBlock Text="Profile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowSettingsCommand}"
                        Classes="navbtn" Classes.active="{Binding IsSettingsActive}"
                        IsVisible="{Binding CanAccessSettings}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
