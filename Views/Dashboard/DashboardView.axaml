<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Dashboard"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ClinicSystem.UI.Views.Dashboard.DashboardView"
             x:Name="Root"
             x:DataType="vm:DashboardViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20" Spacing="16">


            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ROW 1: Stat Cards (2 cards in one row)                     -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*" Height="100">

                <!-- Products -->
                <Border Grid.Column="0" Classes="kpiCard" Margin="0,0,10,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="kpiIcon" Background="#F0FDFA">
                            <materialIcons:MaterialIcon Kind="Pill" Width="22" Height="22" Foreground="#0D9488"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Products" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding TotalProducts}" Classes="kpiValue"/>
                            <Button Command="{Binding NavigateToProductsCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="View all →" Classes="kpiLink" Foreground="#0D9488"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stock Value -->
                <Border Grid.Column="1" Classes="kpiCard" Margin="10,0,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="kpiIcon" Background="#FDF4FF">
                            <materialIcons:MaterialIcon Kind="Receipt" Width="22" Height="22" Foreground="#9333EA"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stock Value" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding TotalStockValue}" Classes="kpiValue"/>
                            <Button Command="{Binding NavigateToInventoryCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="View inventory →" Classes="kpiLink" Foreground="#9333EA"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- KPI Row 2: today's pharma financials -->
            <Grid ColumnDefinitions="*,*,*" Height="100" Margin="0,-6,0,0">
                <!-- Today's Revenue -->
                <Border Grid.Column="0" Classes="kpiCard" Margin="0,0,10,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="kpiIcon" Background="#F0FDF4">
                            <materialIcons:MaterialIcon Kind="Receipt" Width="22" Height="22" Foreground="#16A34A"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Today's Revenue" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding TodayRevenue}" Classes="kpiValue" FontSize="18"/>
                            <Button Command="{Binding NavigateToSalesCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <TextBlock Text="View sales →" Classes="kpiLink" Foreground="#16A34A"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Today's Profit -->
                <Border Grid.Column="1" Classes="kpiCard" Margin="5,0,5,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="kpiIcon" Background="#EFF6FF">
                            <materialIcons:MaterialIcon Kind="ChartBar" Width="22" Height="22" Foreground="#3B82F6"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Today's Profit" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding TodayProfit}" Classes="kpiValue" FontSize="18"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Inventory Value -->
                <Border Grid.Column="2" Classes="kpiCard" Margin="10,0,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="kpiIcon" Background="#F0FDFA">
                            <materialIcons:MaterialIcon Kind="Stethoscope" Width="22" Height="22" Foreground="#0D9488"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Inventory Value" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding TotalStockValue}" Classes="kpiValue" FontSize="18"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>


            <!-- Doctor -> Pharmacy notifications -->
            <Border IsVisible="{Binding CanSeePrescriptionNotifications}" Classes="dashCard" Padding="20,18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#ECFDF5">
                                <materialIcons:MaterialIcon Kind="Bell" Width="18" Height="18" Foreground="#0D9488"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock Text="Prescription Notifications" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushInk900}"/>
                                <TextBlock Text="Patients sent by doctors for pharmacy review" FontSize="12" Foreground="{DynamicResource BrushInk500}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0D9488" CornerRadius="12" Padding="9,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NewPrescriptionCount, StringFormat='{}{0} new'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Linear patient flow indicator strip -->
                    <Border Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center">
                            <Border Background="#DBEAFE" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Stethoscope" Width="12" Height="12" Foreground="#2563EB"/>
                                    <TextBlock Text="Doctor" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="#9CA3AF" Margin="4,0"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="Pill" Width="12" Height="12" Foreground="#D97706"/>
                                    <TextBlock Text="Pharmacist" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="#9CA3AF" Margin="4,0"/>
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="AccountCash" Width="12" Height="12" Foreground="#6B7280"/>
                                    <TextBlock Text="Receptionist" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding PrescriptionNotifications}" IsVisible="{Binding HasPrescriptionNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Prescription">
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushLine}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,2*,*,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EFF6FF">
                                            <materialIcons:MaterialIcon Kind="Account" Width="16" Height="16" Foreground="{DynamicResource BrushPrimaryBlue}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk900}"/>
                                            <TextBlock Text="{Binding PatientPhone, FallbackValue='No phone'}" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="DOCTOR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                                            <TextBlock Text="{Binding DoctorName}" FontSize="12"/>
                                        </StackPanel>
                                        <!-- Step-by-Step Flow Indicator -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <!-- Doctor: Always active/completed since they sent it -->
                                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="12" Height="12" Foreground="#16A34A" ToolTip.Tip="Prescription Sent by Doctor"/>
                                                
                                                <Line StartPoint="0,6" EndPoint="8,6" Stroke="#E5E7EB" StrokeThickness="1.5" VerticalAlignment="Center"/>
                                                
                                                <!-- Pharmacist: Active if Printed or Dispensed, warning/pending if New -->
                                                <Panel>
                                                    <materialIcons:MaterialIcon Kind="CheckCircle" Width="12" Height="12" Foreground="#16A34A" IsVisible="{Binding IsPrintedOrDispensed}" ToolTip.Tip="Printed by Pharmacist"/>
                                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="#F59E0B" IsVisible="{Binding IsSentToPharmacy}" ToolTip.Tip="Pending Pharmacist Print"/>
                                                </Panel>
                                                
                                                <Line StartPoint="0,6" EndPoint="8,6" Stroke="#E5E7EB" StrokeThickness="1.5" VerticalAlignment="Center"/>
                                                
                                                <!-- Receptionist: Active if Dispensed, pending/alert if Printed, grey otherwise -->
                                                <Panel>
                                                    <materialIcons:MaterialIcon Kind="CheckCircle" Width="12" Height="12" Foreground="#16A34A" IsVisible="{Binding IsDispensed}" ToolTip.Tip="Dispensed by Receptionist"/>
                                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="#F59E0B" IsVisible="{Binding IsPrinted}" ToolTip.Tip="Pending Dispensing by Receptionist"/>
                                                    <materialIcons:MaterialIcon Kind="MinusCircleOutline" Width="12" Height="12" Foreground="#9CA3AF" IsVisible="{Binding IsSentToPharmacy}" ToolTip.Tip="Not Yet Printed"/>
                                                </Panel>
                                            </StackPanel>
                                            
                                            <!-- Status Text Label -->
                                            <TextBlock Text="{Binding WorkflowStatusLabel}" FontSize="10" FontWeight="Bold" Foreground="#0D9488"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Command="{Binding #Root.((vm:DashboardViewModel)DataContext).OpenHandoffCommand}"
                                                CommandParameter="{Binding}" Classes="btn-secondary" Padding="12,0" Height="32">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><materialIcons:MaterialIcon Kind="Eye" Width="14" Height="14"/><TextBlock Text="Open"/></StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding !HasPrescriptionNotifications}" HorizontalAlignment="Center" Margin="0,12" Spacing="4">
                        <TextBlock Text="No new patient handoffs" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk600}"/>
                        <TextBlock Text="New prescriptions sent by doctors will appear here." FontSize="11" Foreground="{DynamicResource BrushInk400}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PrescriptionStatusMessage}" FontSize="12" Foreground="#0D9488"/>
                </StackPanel>
            </Border>


            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ADMIN QUICK ACTIONS (Admin only)                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border IsVisible="{Binding IsAdmin}"
                    Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCard}"
                    Padding="18,14">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#EFF6FF">
                            <materialIcons:MaterialIcon Kind="Cog" Width="15" Height="15"
                                      Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Admin Quick Actions" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushInk900}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Administrative options visible to Admin role only"
                                       FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding OpenChangePasswordCommand}"
                                Background="{DynamicResource BrushPrimaryBlue}"
                                Foreground="White" BorderThickness="0"
                                CornerRadius="{DynamicResource CornerRadiusPill}"
                                Padding="16,0" Height="36"
                                ToolTip.Tip="Change your Admin account password">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="AccountCog" Width="13" Height="13"
                                          Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Change Password" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ROW 2: Charts                                               -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="3*,2*" Height="380">

                <!-- Left: Profit & Loss Line Chart -->
                <Border Grid.Column="0" Classes="dashCard" Margin="0,0,10,0">
                    <DockPanel>
                        <!-- Chart Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Profit &amp; Loss Analysis" Classes="cardTitle" VerticalAlignment="Center"/>
                            <!-- Legend -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="3" Background="#10B981" VerticalAlignment="Center" CornerRadius="2"/>
                                    <TextBlock Text="Revenue" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="3" Background="#3799F8" VerticalAlignment="Center" CornerRadius="2"/>
                                    <TextBlock Text="Profit" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Summary Totals Strip -->
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,10,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Total Revenue" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SummaryTotalRevenue}" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Total Profit" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SummaryTotalProfit}" FontSize="15" FontWeight="Bold" Foreground="#3799F8"/>
                            </StackPanel>
                        </Grid>

                        <!-- The chart itself -->
                        <lvc:CartesianChart Series="{Binding ProfitSeries}"
                                            XAxes="{Binding XAxes}"
                                            TooltipPosition="Top"
                                            Background="Transparent"/>
                    </DockPanel>
                </Border>

                <!-- Right: Revenue Overview Donut -->
                <Border Grid.Column="1" Classes="dashCard" Margin="10,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Revenue Overview" Classes="cardTitle" Margin="0,0,0,12"/>

                        <!-- Legend (must be declared BEFORE the fill child) -->
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="Product Sales" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#A78BFA" VerticalAlignment="Center"/>
                                <TextBlock Text="Other Services" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#FBBF24" VerticalAlignment="Center"/>
                                <TextBlock Text="Other Income" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Donut chart area (fill child — declared last) -->
                        <Grid>
                            <lvc:PieChart Series="{Binding RevenueSeries}"
                                          LegendPosition="Hidden"
                                          TooltipPosition="Top"
                                          InitialRotation="-90"
                                          Background="Transparent"/>

                            <!-- Center label overlay -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Total Revenue" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SummaryTotalRevenue}" FontSize="13" FontWeight="Bold"
                                           Foreground="#1F2937" HorizontalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="110" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </DockPanel>
                </Border>

            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ROW 3: Bottom Info Panels                                   -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,*,*" Height="230">

                <!-- Low Stock Alert -->
                <Border Grid.Column="0" Classes="dashCard" Margin="0,0,8,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Alert" Width="16" Height="16" Foreground="#F59E0B"/>
                                <TextBlock Text="Low Stock Alert" Classes="cardTitle" Foreground="#F59E0B"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding NavigateToProductsCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="View all" Foreground="#3B82F6" FontSize="12"/>
                            </Button>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="#F3F4F6" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Foreground="#374151" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="4"
                                                    Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                                           Foreground="#D97706" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Expiring Soon -->
                <Border Grid.Column="1" Classes="dashCard" Margin="8,0,8,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="CalendarCheck" Width="16" Height="16" Foreground="#F59E0B"/>
                                <TextBlock Text="Expiring Soon" Classes="cardTitle"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding NavigateToInventoryCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="View all" Foreground="#3B82F6" FontSize="12"/>
                            </Button>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="#F3F4F6" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ExpiringSoonProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Foreground="#374151" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}"
                                                       Foreground="#EF4444" FontSize="12" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Recent Activities -->
                <Border Grid.Column="2" Classes="dashCard" Margin="8,0,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Clock" Width="16" Height="16" Foreground="#3B82F6"/>
                                <TextBlock Text="Recent Activities" Classes="cardTitle"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="View all" Foreground="#3B82F6" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="#F3F4F6" Margin="0,0,0,8"/>
                        <Panel>
                            <ScrollViewer IsVisible="{Binding HasRecentActivities}">
                                <ItemsControl ItemsSource="{Binding RecentActivities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActivityLog">
                                            <Border Margin="0,2" Padding="8,6" CornerRadius="6"
                                                    Background="Transparent">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                                            Background="#3B82F6" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="#F3F4F6" CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Module}" FontSize="9" Foreground="#6B7280" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" Foreground="#1F2937"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Description}" Foreground="#4B5563"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                            <materialIcons:MaterialIcon Kind="AccountCircle" Width="10" Height="10" Foreground="#9CA3AF"/>
                                                            <TextBlock Text="{Binding UserName}" FontSize="10" Foreground="#9CA3AF"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeAgo}"
                                                               Foreground="#9CA3AF" FontSize="10"
                                                               VerticalAlignment="Top" Margin="8,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty State Overlay -->
                            <StackPanel IsVisible="{Binding HasNoRecentActivities}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,30" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BrushBackground}">
                                    <materialIcons:MaterialIcon Kind="Clock" Width="20" Height="20" Foreground="{DynamicResource BrushInk400}"/>
                                </Border>
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="No recent activities" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk900}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Activities will appear here as you use the system." FontSize="11" Foreground="{DynamicResource BrushInk500}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </DockPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>

    <!-- Prescription detail / dispensing workflow -->
    <Border IsVisible="{Binding ShowHandoffDetails}" Background="#880F172A" ZIndex="100">
        <Border Width="720" MaxHeight="600" Background="{DynamicResource BrushCardBackground}" CornerRadius="12"
                Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Prescription Review" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushInk900}"/>
                        <TextBlock Text="Doctor → Pharmacist → Receptionist" FontSize="12" Foreground="#0D9488" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseHandoffCommand}" Background="Transparent" BorderThickness="0" Width="34" Height="34">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">
                        <Border Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="PATIENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                                    <TextBlock Text="{Binding SelectedHandoff.PatientName}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedHandoff.PatientPhone, StringFormat='Phone: {0}'}" Foreground="{DynamicResource BrushInk600}"/>
                                    <TextBlock Text="{Binding SelectedHandoff.PatientAge, StringFormat='Age: {0}'}" Foreground="{DynamicResource BrushInk600}"/>
                                    <!-- Appointment reference -->
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left"
                                            IsVisible="{Binding SelectedHandoff.AppointmentID, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding SelectedHandoff.AppointmentID, StringFormat='APT-{0}'}" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Text="PRESCRIBED BY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedHandoff.DoctorName}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedHandoff.VisitDate, StringFormat='{}{0:dd MMM yyyy, h:mm tt}'}" Foreground="{DynamicResource BrushInk500}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedHandoff.SentToPharmacyAt, StringFormat='Sent: {0:h:mm tt}'}" Foreground="{DynamicResource BrushInk400}" FontSize="10" HorizontalAlignment="Right"
                                               IsVisible="{Binding SelectedHandoff.SentToPharmacyAt, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Spacing="5" IsVisible="{Binding SelectedHandoff.LabTests, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="LAB TESTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                            <TextBlock Text="{Binding SelectedHandoff.LabTests}" TextWrapping="Wrap" Foreground="{DynamicResource BrushInk800}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding SelectedHandoff.Items}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="DOSAGE / DIRECTIONS" Binding="{Binding Dosage}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Receptionist read-only notice -->
                        <Border Background="#FEF9C3" CornerRadius="6" Padding="10,7"
                                IsVisible="{Binding !CanManagePrescriptionHandoffs}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" Foreground="#92400E"/>
                                <TextBlock Text="View only — actions are restricted to the Pharmacist." FontSize="11" Foreground="#92400E"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PrescriptionStatusMessage}" Foreground="#0D9488" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                    <Button Grid.Column="0" Command="{Binding CloseHandoffCommand}" Classes="btn-secondary" HorizontalAlignment="Left" Content="Close"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanManagePrescriptionHandoffs}">
                        <Button Command="{Binding PrintHandoffCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="7"><materialIcons:MaterialIcon Kind="Printer" Width="15" Height="15"/><TextBlock Text="Check &amp; Print"/></StackPanel>
                        </Button>
                        <Button Command="{Binding MarkMedicinesGivenCommand}" IsEnabled="{Binding CanDispenseSelected}"
                                Background="#0D9488" Foreground="White" BorderThickness="0" CornerRadius="6" Padding="16,0" Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="7"><materialIcons:MaterialIcon Kind="CheckCircle" Width="15" Height="15"/><TextBlock Text="Medicines Given"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
    </Grid>

    <UserControl.Styles>

        <!-- KPI (top stat) card -->
        <Style Selector="Border.kpiCard">
            <Setter Property="Background" Value="{DynamicResource BrushCardBackground}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #0A000000"/>
        </Style>

        <!-- KPI icon box -->
        <Style Selector="Border.kpiIcon">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- KPI text styles -->
        <Style Selector="TextBlock.kpiLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk600}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontInter}"/>
        </Style>
        <Style Selector="TextBlock.kpiValue">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
        </Style>
        <Style Selector="TextBlock.kpiLink">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontInter}"/>
        </Style>

        <!-- General dashboard card -->
        <Style Selector="Border.dashCard">
            <Setter Property="Background" Value="{DynamicResource BrushCardBackground}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #0A000000"/>
        </Style>

        <!-- Card title -->
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontLexend}"/>
        </Style>

    </UserControl.Styles>

</UserControl>
