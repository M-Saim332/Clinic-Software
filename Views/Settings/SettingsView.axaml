<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Settings"
             xmlns:userviews="using:ClinicSystem.UI.Views.Users"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel" x:CompileBindings="True"
             Background="{DynamicResource ThemeContentBackgroundBrush}">

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══════════════════════════════ HEADER ═══════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeCardBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,18">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource ThemePrimaryLightBrush}">
                        <materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20"
                                  Foreground="{DynamicResource ThemePrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeContentForegroundBrush}"
                                   FontFamily="{DynamicResource FontLexend}"/>
                        <TextBlock Text="Manage clinic configuration, defaults, database backups, and security settings"
                                   FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Command="{Binding SaveSettingsCommand}" IsVisible="{Binding IsAdmin}"
                        Classes="btn-primary" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
                        <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════ MAIN CONTENT ═════════════════════════ -->
        <Border Grid.Row="1" IsVisible="{Binding !IsAdmin}" Margin="28,24" Padding="24"
                Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="16" MaxWidth="520">
                <TextBlock Text="Account Security" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Receptionist settings are limited to changing your own password." TextWrapping="Wrap" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                <Button Command="{Binding OpenChangePasswordCommand}" Classes="btn-primary" Content="Change My Password" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="0,24" IsVisible="{Binding IsAdmin}" SelectedIndex="{Binding SelectedCategoryIndex}" Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleForegroundBrush}"/>
                    <Setter Property="MinHeight" Value="40"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Background" Value="{DynamicResource ThemePrimaryLightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                </Style>
                <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ── GENERAL SETTINGS ─────────────────────────────────── -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="GENERAL SETTINGS" Classes="sectionLabel"/>
                        <Separator/>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,12">
                                <TextBlock Text="Pharmacy Name" Classes="label"/>
                                <TextBox Text="{Binding PharmacyName}" PlaceholderText="Enter pharmacy name"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,12,12">
                                <TextBlock Text="Clinic Name" Classes="label"/>
                                <TextBox Text="{Binding ClinicName}" PlaceholderText="Enter clinic name"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="12,0,0,12">
                                <TextBlock Text="Contact Number" Classes="label"/>
                                <TextBox Text="{Binding ClinicPhone}" PlaceholderText="03001234567" MaxLength="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" Margin="0,12,12,0">
                                <TextBlock Text="Email Address" Classes="label"/>
                                <TextBox Text="{Binding ClinicEmail}" PlaceholderText="Enter clinic email"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="12,12,0,0">
                                <TextBlock Text="Physical Address" Classes="label"/>
                                <TextBox Text="{Binding ClinicAddress}" PlaceholderText="Enter clinic physical address"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ── INVENTORY SETTINGS ────────────────────────────────── -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="INVENTORY SETTINGS" Classes="sectionLabel"/>
                        <Separator/>
                        <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                <TextBlock Text="Expiry Alert Days" Classes="label"/>
                                <NumericUpDown Value="{Binding ExpiryAlertDays}" Minimum="1" Maximum="365"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ── SYSTEM SETTINGS ───────────────────────────────────── -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="SYSTEM SETTINGS" Classes="sectionLabel"/>
                        <Separator/>
                        <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                <TextBlock Text="Date Format" Classes="label"/>
                                <comp:SearchableComboBoxControl ItemsSource="{Binding DateFormatOptions}"
                                          SelectedItem="{Binding DateFormat}" DisplayMemberPath="" Placeholder="Search date format..."
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,12,0">
                                <TextBlock Text="Time Format" Classes="label"/>
                                <comp:SearchableComboBoxControl ItemsSource="{Binding TimeFormatOptions}"
                                          SelectedItem="{Binding TimeFormat}" DisplayMemberPath="" Placeholder="Search time format..."
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" Margin="12,0,0,0">
                                <TextBlock Text="Language" Classes="label"/>
                                <comp:SearchableComboBoxControl ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding Language}" DisplayMemberPath="" Placeholder="Search language..."
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ══════════════════════════════════════════════════════════
                     APPEARANCE &amp; THEME  (Admin only)
                ══════════════════════════════════════════════════════════ -->
                <Border IsVisible="{Binding IsAdmin}"
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="24">
                    <StackPanel Spacing="20">

                        <!-- Header row -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Spacing="4">
                                <TextBlock Text="APPEARANCE &amp; THEME" Classes="sectionLabel"/>
                                <TextBlock Text="Choose a professional preset or create your own custom theme. Changes apply instantly."
                                           FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                            </StackPanel>
                            <!-- Active theme badge -->
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource ThemePrimaryLightBrush}"
                                    CornerRadius="20" Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="{DynamicResource ThemePrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedTheme}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemePrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- ── DEFAULT THEMES ──────────────────────────────── -->
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PaletteSwatch" Width="16" Height="16"
                                             Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                <TextBlock Text="Default Theme" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding BuiltInThemesList}"
                                     SelectedValueBinding="{Binding Name}"
                                     SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding"      Value="0"/>
                                        <Setter Property="Margin"       Value="0,0,12,12"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                        <Setter Property="Background"   Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Border.themeCard">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8" Width="165">
                                            <Border Classes="themeCard" Width="165" Height="120"
                                                    CornerRadius="12" ClipToBounds="True"
                                                    BorderThickness="2.5" BorderBrush="#E2E8F0"
                                                    Background="White">
                                                <!-- Mini app layout preview -->
                                                <Grid ColumnDefinitions="36,*">
                                                    <!-- Sidebar strip -->
                                                    <Border Grid.Column="0" Background="{Binding SidebarBackground}"
                                                            CornerRadius="10,0,0,10">
                                                        <StackPanel Spacing="6" Margin="6,12,6,0">
                                                            <Border Height="4" CornerRadius="2" Background="{Binding SidebarActiveForeground}" Opacity="0.9"/>
                                                            <Border Height="4" CornerRadius="2" Background="{Binding SidebarForeground}" Opacity="0.5"/>
                                                            <Border Height="4" CornerRadius="2" Background="{Binding SidebarForeground}" Opacity="0.5"/>
                                                            <Border Height="4" CornerRadius="2" Background="{Binding SidebarForeground}" Opacity="0.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Content area preview -->
                                                    <Border Grid.Column="1" Background="{Binding ContentBackground}"
                                                            CornerRadius="0,10,10,0" Padding="8,10">
                                                        <StackPanel Spacing="5">
                                                            <!-- Top bar mock -->
                                                            <Border Height="6" Width="60" CornerRadius="3"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{Binding TopBarBackground}"/>
                                                            <!-- Card mock 1 -->
                                                            <Border Height="24" CornerRadius="5"
                                                                    Background="{Binding CardBackground}"
                                                                    BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                                                <Border Width="22" Height="4" CornerRadius="2" Margin="6,0,0,0"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Background="{Binding Primary}" Opacity="0.7"/>
                                                            </Border>
                                                            <!-- Accent button mock -->
                                                            <Border Height="14" Width="40" CornerRadius="4"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{Binding Primary}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <!-- Overlay: name + selected ring -->
                                                <Border.Styles>
                                                    <Style Selector="Border.themeCard">
                                                        <Setter Property="Transitions">
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                                            </Transitions>
                                                        </Setter>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <!-- Custom themes section — only shown when any exist -->
                        <Border IsVisible="{Binding !!CustomThemesList.Count}"
                                Background="{DynamicResource ThemeContentBackgroundBrush}"
                                CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Palette" Width="16" Height="16"
                                                 Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                    <TextBlock Text="Custom Themes" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding CustomThemesList}"
                                         SelectedValueBinding="{Binding Name}"
                                         SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding"      Value="0"/>
                                            <Setter Property="Margin"       Value="0,0,12,8"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="Background"   Value="Transparent"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected Border.themeCard">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="4" Width="165">
                                                <!-- Theme card preview -->
                                                <Border Classes="themeCard" Height="100" CornerRadius="10" ClipToBounds="True"
                                                        BorderThickness="2"
                                                        BorderBrush="{DynamicResource ThemeBorderBrush}">
                                                    <Grid ColumnDefinitions="36,*">
                                                        <Border Grid.Column="0" Background="{Binding SidebarBackground}" CornerRadius="8,0,0,8"/>
                                                        <Border Grid.Column="1" Background="{Binding ContentBackground}" CornerRadius="0,8,8,0"
                                                                Padding="6,8">
                                                            <StackPanel Spacing="4">
                                                                <Border Height="14" CornerRadius="3" Background="{Binding Primary}"/>
                                                                <Border Height="8" CornerRadius="2" Background="{Binding BorderColor}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <!-- Name + delete -->
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding $parent[UserControl].DataContext.DeleteCustomThemeCommand}"
                                                            CommandParameter="{Binding Name}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Width="22" Height="22" Padding="0" CornerRadius="4">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                     Foreground="#EF4444"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,4"/>

                        <!-- ═══════════════════════════════════════════════════
                             CUSTOM THEME BUILDER
                        ═══════════════════════════════════════════════════ -->
                        <Border Background="{DynamicResource ThemeContentBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Builder header -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{DynamicResource ThemePrimaryLightBrush}">
                                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource ThemePrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Create Custom Theme" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemeContentForegroundBrush}"/>
                                        <TextBlock Text="Define your own color palette — companion shades are derived automatically."
                                                   FontSize="11" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Responsive fields: two columns prevent controls from colliding on smaller screens. -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="16" RowSpacing="14">
                                    <!-- Theme Name -->
                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="Theme Name" Classes="label"/>
                                        <TextBox Text="{Binding NewThemeName}" PlaceholderText="e.g. My Clinic Blue"/>
                                    </StackPanel>

                                    <!-- Sidebar Color -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="Sidebar Color (hex)" Classes="label"/>
                                        <Grid ColumnDefinitions="36,*">
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    CornerRadius="6" Margin="0,0,4,0"
                                                    Background="{Binding CustomBuilderPreviewSidebar}"/>
                                            <TextBox Grid.Column="1" Text="{Binding NewThemeSidebarHex}"
                                                     PlaceholderText="#1E293B"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- TopBar Color -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
                                        <TextBlock Text="TopBar Color (hex)" Classes="label"/>
                                        <Grid ColumnDefinitions="36,*">
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    CornerRadius="6" Margin="0,0,4,0"
                                                    Background="{Binding CustomBuilderPreviewTopBar}"/>
                                            <TextBox Grid.Column="1" Text="{Binding NewThemeTopBarHex}"
                                                     PlaceholderText="#FFFFFF"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Primary Color -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Primary Color (hex)" Classes="label"/>
                                        <Grid ColumnDefinitions="36,*">
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    CornerRadius="6" Margin="0,0,4,0"
                                                    Background="{Binding CustomBuilderPreviewPrimary}"/>
                                            <TextBox Grid.Column="1" Text="{Binding NewThemePrimaryHex}"
                                                     PlaceholderText="#4F46E5"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Dark mode toggle + Create button -->
                                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding NewThemeIsDark}"
                                                      Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                                      FontSize="13"/>
                                            <TextBlock Text="Dark Mode" FontSize="13"
                                                       Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding CreateCustomThemeCommand}"
                                                Classes="btn-primary" Height="44">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                                <TextBlock Text="Create Theme" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Status message -->
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"
                                               Text="{Binding CustomBuilderMessage}"
                                               FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding CustomBuilderMessage.Length}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Database">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ── DATABASE &amp; MAINTENANCE ────────────────────────── -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="DATABASE &amp; MAINTENANCE" Classes="sectionLabel"/>
                        <Separator/>

                        <!-- Backup / Restore -->
                        <DockPanel>
                            <StackPanel Spacing="4" DockPanel.Dock="Left">
                                <TextBlock Text="Backup &amp; Restore" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeContentForegroundBrush}"/>
                                <TextBlock Text="Save a full database backup or restore from an existing .bak file."
                                           FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                           TextWrapping="Wrap" MaxWidth="440"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding BackupCommand}" Classes="btn-secondary"
                                        IsEnabled="{Binding !IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DatabaseExport" Width="18" Height="18"/>
                                        <TextBlock Text="Backup Database" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RestoreCommand}" Classes="btn-secondary"
                                        IsEnabled="{Binding !IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DatabaseImport" Width="18" Height="18"/>
                                        <TextBlock Text="Restore Database" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <Separator Margin="0,4"/>

                        <!-- Delete All Data -->
                        <DockPanel>
                            <StackPanel Spacing="4" DockPanel.Dock="Left">
                                <TextBlock Text="Delete All Data" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#DC2626"/>
                                <TextBlock Text="Wipes ALL products, patients, companies, transactions etc. Users are preserved. A rollback backup is created automatically before deletion."
                                           FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                           TextWrapping="Wrap" MaxWidth="440"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding RollbackResetCommand}"
                                        IsVisible="{Binding IsRollbackAvailable}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Background="#F59E0B" Foreground="White"
                                        BorderThickness="0" CornerRadius="{DynamicResource CornerRadiusPill}"
                                        Padding="14,0" Height="36" FontSize="13" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Undo" Width="18" Height="18"/>
                                        <TextBlock Text="Rollback Reset" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowResetConfirmCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Background="#DC2626" Foreground="White"
                                        BorderThickness="0" CornerRadius="{DynamicResource CornerRadiusPill}"
                                        Padding="14,0" Height="36" FontSize="13" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Delete" Width="18" Height="18"/>
                                        <TextBlock Text="Delete All Data" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Confirmation banner -->
                        <Border IsVisible="{Binding IsResetConfirmVisible}"
                                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Are you absolutely sure?" FontSize="14" FontWeight="Bold" Foreground="#991B1B"/>
                                        <TextBlock Text="This will permanently delete all clinical data. A rollback backup will be saved first so you can undo this action."
                                                   FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" MaxWidth="500"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Command="{Binding ConfirmResetCommand}"
                                            Background="#DC2626" Foreground="White"
                                            BorderThickness="0" CornerRadius="{DynamicResource CornerRadiusPill}"
                                            Padding="16,0" Height="36" FontSize="13" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Delete" Width="18" Height="18"/>
                                            <TextBlock Text="Yes, Delete Everything" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelResetCommand}" Classes="btn-secondary">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

                <!-- ── ADMIN SECURITY ─────────────────────────────────────── -->
                <Border IsVisible="{Binding IsAdmin}"
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="#FCA5A5" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="ADMIN SECURITY" Classes="sectionLabel"
                                   Foreground="{DynamicResource BrushRose}"/>
                        <Separator Background="#FCA5A5"/>
                        <DockPanel>
                            <StackPanel Spacing="4" DockPanel.Dock="Left">
                                <TextBlock Text="Change Admin Password" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeContentForegroundBrush}"/>
                                <TextBlock Text="Update your admin account password. You will need to verify your current password first."
                                           FontSize="12" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                                           TextWrapping="Wrap" MaxWidth="480"/>
                            </StackPanel>
                            <Button Command="{Binding OpenChangePasswordCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource BrushRose}" Foreground="White"
                                    BorderThickness="0" CornerRadius="{DynamicResource CornerRadiusPill}"
                                    Padding="16,0" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="AccountCog" Width="13" Height="13"
                                              Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Change Password" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Users">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,28,0">
                    <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">

                <!-- ── USER MANAGEMENT (Admin only) ──────────────────────── -->
                <Border IsVisible="{Binding IsAdmin}"
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusCard}" Padding="0" Height="700">
                    <userviews:UserRegistryView DataContext="{Binding UserRegistryVM}" />
                </Border>

            </StackPanel>
        </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── Status Bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource ThemeCardBackgroundBrush}"
                Padding="28,16" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource ThemeSubtleForegroundBrush}"
                       FontSize="13" VerticalAlignment="Center" FontWeight="Medium"/>
        </Border>
    </Grid>

    <!-- Change Password Modal -->
    <Panel IsVisible="{Binding IsChangePasswordVisible}" ZIndex="200">
        <userviews:ChangePasswordView DataContext="{Binding ChangePasswordVM}"/>
    </Panel>

    </Panel>

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Foreground"     Value="{DynamicResource ThemeSubtleForegroundBrush}"/>
            <Setter Property="LetterSpacing"  Value="1.2"/>
            <Setter Property="FontFamily"     Value="{DynamicResource FontLexend}"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSubtleForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background"  Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ThemeContentForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"     Value="12,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background"  Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ThemeContentForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"     Value="12,8"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background"  Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"     Value="12,8"/>
        </Style>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background"      Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="{DynamicResource ThemePrimaryHoverBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background"      Value="{DynamicResource ThemeContentBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThemeContentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="CornerRadius"    Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
        <!-- Theme card selection ring -->
        <Style Selector="ListBoxItem:selected Border.themeCard">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
