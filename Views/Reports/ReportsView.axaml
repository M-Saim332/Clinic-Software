<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Reports"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Reports.ReportsView"
             x:DataType="vm:ReportsViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushPrimaryBlue50}">
                        <materialIcons:MaterialIcon Kind="ChartBar" Width="20" Height="20"
                                  Foreground="{DynamicResource BrushPrimaryBlue}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Reports &amp; Analytics" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushInk900}"
                                   FontFamily="{DynamicResource FontLexend}"/>
                        <TextBlock Text="Generate PDF summaries, check stocks, alerts, visit history, and financials"
                                   FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="28,20">
            <!-- Tab 1: Patient List -->
            <TabItem Header="Patient List">
                <comp:DataTableShellControl Title="Patients Database Summary" RecordCount="{Binding PatientList.Count}">
                    <comp:DataTableShellControl.HeaderActions>
                        <comp:ExportToolbarControl ReportName="Patient_List" ItemsSource="{Binding PatientList}"
                            Columns="ID:PatientID|Name:Name:2|Age:Age|Gender:Gender|Contact:Contact|Address:Address:2"/>
                    </comp:DataTableShellControl.HeaderActions>
                    <comp:DataTableShellControl.FilterToolbar>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding LoadPatientListCommand}" Classes="btn-secondary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Clock" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh Data" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid ItemsSource="{Binding PatientList}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PatientID}" Width="70"/>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="90"/>
                                <DataGridTextColumn Header="GENDER" Binding="{Binding Gender}" Width="110"/>
                                <DataGridTextColumn Header="CONTACT" Binding="{Binding Contact}" Width="150"/>
                                <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </TabItem>

            <!-- Tab 2: Product Stock -->
            <TabItem Header="Product Stock">
                <comp:DataTableShellControl Title="Stock Level Listing" RecordCount="{Binding ProductStockList.Count}">
                    <comp:DataTableShellControl.HeaderActions>
                        <comp:ExportToolbarControl ReportName="Product_Stock" ItemsSource="{Binding ProductStockList}"
                            Columns="Product Name:Name:2|Stock Level:StockBreakdown|Minimum Level:MinStock|Status:StockStatus|Expiry:ExpiryDate|MRP:MRP|Manufacturer:Manufacturer:2"/>
                    </comp:DataTableShellControl.HeaderActions>
                    <comp:DataTableShellControl.FilterToolbar>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding LoadProductStockCommand}" Classes="btn-secondary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Clock" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh Data" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid ItemsSource="{Binding ProductStockList}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="STOCK LEVEL" Binding="{Binding StockBreakdown}" Width="190"/>
                                <DataGridTextColumn Header="MINIMUM LEVEL" Binding="{Binding MinStock}" Width="140"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding StockStatus}" Width="130"/>
                                <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=\{0:dd MMM yyyy\}}" Width="130"/>
                                <DataGridTextColumn Header="MRP" Binding="{Binding MRP, StringFormat='Rs. {0:N2}'}" Width="110"/>
                                <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </TabItem>

            <!-- Tab 3: Alerts -->
            <TabItem Header="Alerts">
                <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                    <!-- Expired products panel -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Margin="0,0,12,0" Padding="16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Text="EXPIRED PRODUCTS (DO NOT SELL)" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushRose}" LetterSpacing="1.5"
                                           FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
                                <comp:ExportToolbarControl Grid.Column="1" ReportName="Expired_Products" ItemsSource="{Binding ExpiredProducts}"
                                    Columns="Name:Name:2|Stock:StockBreakdown|Expiry Date:ExpiryDate"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding ExpiredProducts}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockBreakdown}" Width="190"/>
                                    <DataGridTextColumn Header="EXPIRY DATE" Binding="{Binding ExpiryDate, StringFormat=\{0:dd MMM yyyy\}}" Width="145"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Low Stock products panel -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Margin="12,0,0,0" Padding="16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Text="LOW STOCK ALERTS (REORDER SOON)" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAmber}" LetterSpacing="1.5"
                                           FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
                                <comp:ExportToolbarControl Grid.Column="1" ReportName="Low_Stock_Alerts" ItemsSource="{Binding LowStockProducts}"
                                    Columns="Name:Name:2|Stock:StockBreakdown|Minimum Required:MinStock"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockBreakdown}" Width="190"/>
                                    <DataGridTextColumn Header="MINIMUM REQUIRED" Binding="{Binding MinStock}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Visit History -->
            <TabItem Header="Visit History">
                <comp:DataTableShellControl Title="Patient Visits" RecordCount="{Binding AllVisits.Count}">
                    <comp:DataTableShellControl.HeaderActions>
                        <comp:ExportToolbarControl ReportName="Visit_History" ItemsSource="{Binding AllVisits}"
                            Columns="Date:VisitDate|Patient:PatientName:2|Doctor:DoctorName|Lab Tests:LabTests:2"/>
                    </comp:DataTableShellControl.HeaderActions>
                    <comp:DataTableShellControl.FilterToolbar>
                        <Button Command="{Binding LoadAllVisitsCommand}" Classes="btn-secondary" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Clock" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Data" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid ItemsSource="{Binding AllVisits}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE"    Binding="{Binding VisitDate, StringFormat=\{0:dd MMM yyyy\}}" Width="130"/>
                                <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientName}" Width="*"/>
                                <DataGridTextColumn Header="DOCTOR"  Binding="{Binding DoctorName}"  Width="160"/>
                                <DataGridTextColumn Header="LAB TESTS" Binding="{Binding LabTests}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </TabItem>

            <!-- Tab 5: Financials -->
            <TabItem Header="Financials">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Start Date" FontSize="11"/><DatePicker SelectedDate="{Binding StartDate}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="End Date" FontSize="11"/><DatePicker SelectedDate="{Binding EndDate}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0" Width="210"><TextBlock Text="Receptionist" FontSize="11"/><comp:SearchableComboBoxControl ItemsSource="{Binding ReceptionistNames}" SelectedItem="{Binding SelectedReceptionist}" DisplayMemberPath="" Placeholder="Search receptionist..."/></StackPanel>
                        <Button Command="{Binding LoadFinancialsCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Clock" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Data" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadWeeklyReportCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="ChartBar" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                <TextBlock Text="Download Weekly PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadMonthlyReportCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="ChartBar" Width="14" Height="14" Foreground="{DynamicResource BrushInk600}" VerticalAlignment="Center"/>
                                <TextBlock Text="Download Monthly PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <comp:ExportToolbarControl ReportName="Financials" ItemsSource="{Binding FinancialSummaryRows}"
                            Columns="Metric:Metric:2|Value:Value"/>
                    </WrapPanel>

                    <!-- Financial Summary cards in full-page swap layout style -->
                    <WrapPanel HorizontalAlignment="Left">
                        <comp:SummaryCardControl Title="Medicines Sold (units)" Value="{Binding TotalMedicinesSold, StringFormat={}{0}}" BorderColor="{DynamicResource BrushPrimaryBlue}" Width="300" Margin="0,0,16,16"/>
                        <comp:SummaryCardControl Title="Gross Revenue" Value="{Binding TotalRevenue, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushTeal}" Width="300" Margin="0,0,16,16"/>
                        <comp:SummaryCardControl Title="Patient Returns" Value="{Binding TotalReturns, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushRose}" Width="300" Margin="0,0,16,16"/>
                        <comp:SummaryCardControl Title="Net Revenue" Value="{Binding NetRevenue, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushTeal}" Width="300" Margin="0,0,16,16"/>
                        <comp:SummaryCardControl Title="Total Expenses (Purchases)" Value="{Binding TotalExpenses, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushRose}" Width="380"/>
                        <comp:SummaryCardControl Title="Supplier Return Credits" Value="{Binding SupplierCredits, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushAmber}" Width="300" Margin="16,0,16,0"/>
                        <comp:SummaryCardControl Title="Gross Profit" Value="{Binding GrossProfit, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushPrimaryBlue}" Width="300" Margin="0,0,16,0"/>
                        <comp:SummaryCardControl Title="Net Profit" Value="{Binding NetProfit, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushPrimaryBlue}" Width="300"/>
                    </WrapPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="Sale Invoice Summary">
                <DockPanel Margin="0,12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                    <DatePicker SelectedDate="{Binding StartDate}"/><DatePicker SelectedDate="{Binding EndDate}"/>
                    <comp:SearchableComboBoxControl ItemsSource="{Binding ReceptionistNames}" SelectedItem="{Binding SelectedReceptionist}" DisplayMemberPath="" Placeholder="Search receptionist..." IsVisible="{Binding CanFilterByUser}" Width="220"/>
                    <Button Command="{Binding LoadPharmaReportsCommand}" Content="Apply Filters" Classes="btn-secondary"/>
                    <comp:ExportToolbarControl ReportName="Sale_Invoice_Summary" ItemsSource="{Binding SaleInvoiceSummary}"
                        Columns="Invoice No:InvoiceNumber|Date:SaleDate|Patient:PatientName:2|Receptionist:ReceptionistName|Total:GrandTotal"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SaleInvoiceSummary}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" Width="150"/><DataGridTextColumn Header="DATE" Binding="{Binding SaleDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="130"/>
                        <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientName}" Width="*"/><DataGridTextColumn Header="RECEPTIONIST" Binding="{Binding ReceptionistName}" Width="180"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding GrandTotal, StringFormat='Rs. {0:N2}'}" Width="140"/></DataGrid.Columns></DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Best Selling Products">
                <DockPanel Margin="0,12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12"><Button Command="{Binding LoadPharmaReportsCommand}" Content="Refresh" Classes="btn-secondary"/>
                    <comp:ExportToolbarControl ReportName="Best_Selling_Products" ItemsSource="{Binding BestSellingProducts}"
                        Columns="Product:ProductName:2|Pieces Sold:PiecesSold|Revenue:Revenue"/></StackPanel>
                    <DataGrid ItemsSource="{Binding BestSellingProducts}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="PIECES SOLD" Binding="{Binding PiecesSold}" Width="150"/>
                        <DataGridTextColumn Header="REVENUE" Binding="{Binding Revenue, StringFormat='Rs. {0:N2}'}" Width="170"/></DataGrid.Columns></DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Company-wise Sale">
                <DockPanel Margin="0,12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12"><Button Command="{Binding LoadPharmaReportsCommand}" Content="Refresh" Classes="btn-secondary"/>
                    <comp:ExportToolbarControl ReportName="Company_wise_Sale" ItemsSource="{Binding CompanyWiseSales}"
                        Columns="Company:CompanyName:2|Pieces:PiecesSold|Sales:Revenue|Cost:Cost|Profit:Profit"/></StackPanel>
                    <DataGrid ItemsSource="{Binding CompanyWiseSales}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="COMPANY" Binding="{Binding CompanyName}" Width="*"/><DataGridTextColumn Header="PIECES" Binding="{Binding PiecesSold}" Width="110"/>
                        <DataGridTextColumn Header="SALES" Binding="{Binding Revenue, StringFormat='Rs. {0:N2}'}" Width="150"/><DataGridTextColumn Header="COST" Binding="{Binding Cost, StringFormat='Rs. {0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="PROFIT" Binding="{Binding Profit, StringFormat='Rs. {0:N2}'}" Width="150"/></DataGrid.Columns></DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="P&amp;L Summary">
                <DockPanel Margin="0,20">
                    <comp:ExportToolbarControl DockPanel.Dock="Top" HorizontalAlignment="Right" ReportName="P_and_L_Summary" ItemsSource="{Binding ProfitLossSummaryRows}"
                        Columns="Metric:Metric:2|Value:Value"/>
                <WrapPanel>
                    <comp:SummaryCardControl Title="Revenue" Value="{Binding TotalRevenue, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushTeal}" Width="280" Margin="0,0,16,16"/>
                    <comp:SummaryCardControl Title="Purchases" Value="{Binding TotalExpenses, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushRose}" Width="280" Margin="0,0,16,16"/>
                    <comp:SummaryCardControl Title="Returns" Value="{Binding TotalReturns, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushAmber}" Width="280" Margin="0,0,16,16"/>
                    <comp:SummaryCardControl Title="Net Profit / Loss" Value="{Binding NetProfit, StringFormat='Rs. {0:N2}'}" BorderColor="{DynamicResource BrushPrimaryBlue}" Width="300"/>
                </WrapPanel>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BrushCardBackground}"
                BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushInk600}"
                           VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="100" Height="4"
                             Foreground="{DynamicResource BrushPrimaryBlue}" Background="{DynamicResource BrushLine}"
                             DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>
</UserControl>
