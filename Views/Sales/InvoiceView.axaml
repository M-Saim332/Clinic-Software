<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Sales"
             x:Class="ClinicSystem.UI.Views.Sales.InvoiceView"
             x:DataType="vm:InvoiceViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18">
            <Border Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <DockPanel>
                    <Button Command="{Binding GoBackCommand}" Classes="btn-secondary" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            <TextBlock Text="Back to List"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushPrimaryBlue}" VerticalAlignment="Center"/>
                        <Button Command="{Binding PrintCommand}" Classes="btn-primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                <TextBlock Text="Print / Export PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EmailDocumentCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18"/>
                                <TextBlock Text="Email Document"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Width="800" MinHeight="1120" HorizontalAlignment="Center"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="0" Padding="40,48" BoxShadow="0 8 24 0 #18000000">
                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="8" Background="#EFF6FF">
                                    <materialIcons:MaterialIcon Kind="HospitalBuilding" Width="24" Height="24"
                                        Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ClinicName}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text="{Binding ClinicAddress}" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ClinicPhone}" FontSize="12" Foreground="#6B7280"
                                               IsVisible="{Binding ClinicPhone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="SALES INVOICE" FontSize="24" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SaleData.InvoiceNumber, StringFormat='Invoice No: {0}'}" FontSize="13" Foreground="#374151" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SaleData.SaleDate, StringFormat='Date: {0:dd MMM yyyy}'}" FontSize="13" Foreground="#374151" HorizontalAlignment="Right"/>
                            <Border Background="#ECFDF5" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DocumentStatus}" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="{Binding SaleData.ReceptionistName, StringFormat='Processed by: {0}'}" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="BILLED TO" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SaleData.PatientName}" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                                <TextBlock Text="{Binding SaleData.PaymentMethod, StringFormat='Payment method: {0}'}" FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="INVOICE META INFORMATION" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SaleData.InvoiceNumber}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding LineItems.Count, StringFormat='Line items: {0}'}" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding LineItems}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SaleItemID}" Width="48"/>
                            <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="BATCH / EXPIRY" Binding="{Binding BatchExpiryDisplay}" Width="110"/>
                            <DataGridTextColumn Header="QTY / PIECES" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="UNIT RATE / T.P / MRP" Binding="{Binding RateDisplay}" Width="150"/>
                            <DataGridTextColumn Header="TAX / DISCOUNT" Binding="{Binding TaxDiscountDisplay}" Width="120"/>
                            <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding LineNetTotal, StringFormat='Rs. {0:N2}'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid ColumnDefinitions="*,300">
                        <TextBlock Grid.Column="0" Text="Thank you for your visit. Please keep this invoice for returns and audit reference."
                                   Foreground="#6B7280" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Sub Total" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentSubTotal, StringFormat='Rs. {0:N2}'}" Foreground="#111827"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Taxes &amp; Discounts" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentAdjustmentsTotal, StringFormat='Rs. {0:N2}'}" Foreground="#111827"/>
                            </Grid>
                            <Separator Background="#D1D5DB"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Grand Total" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentGrandTotal, StringFormat='Rs. {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
    </UserControl.Styles>
</UserControl>
