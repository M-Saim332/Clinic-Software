<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Sales"
             x:Class="ClinicSystem.UI.Views.Sales.InvoiceView"
             x:DataType="vm:InvoiceViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18">
            <Border Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <DockPanel>
                    <Button Command="{Binding GoBackCommand}" Classes="btn-secondary" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            <TextBlock Text="Back to List"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushPrimaryBlue}" VerticalAlignment="Center"/>
                        <Button Command="{Binding PrintCommand}" Classes="btn-primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                <TextBlock Text="Print / Export PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EmailDocumentCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18"/>
                                <TextBlock Text="Email Document"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border MaxWidth="800" MinHeight="1120" HorizontalAlignment="Center" Margin="0,0"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="0" Padding="32" BoxShadow="0 4 12 0 #11000000">
                <StackPanel Spacing="16">
                    <!-- Company Header -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Al Mustafa Distribution Pvt Ltd" FontSize="26" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                        <TextBlock Text="Main Wholesale Medicine Market, Pakistan" FontSize="13" Foreground="#4B5563" HorizontalAlignment="Center"/>
                        <TextBlock Text="Phone: 021-0000000, 0300-0000000" FontSize="13" Foreground="#4B5563" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Document Title -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,8,0,16" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="SALE INVOICE" FontSize="18" FontWeight="ExtraBold" LetterSpacing="2" Foreground="#111827" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 2-Column Header Metadata -->
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,16">
                        <!-- Left Column: Invoice Info -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Text="Invoice #:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SaleData.InvoiceNumber}" FontSize="12" FontWeight="Bold" Foreground="#111827"/>
                            
                            <TextBlock Grid.Row="1" Text="Invoice Date:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SaleData.SaleDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" Foreground="#111827"/>
                            
                            <TextBlock Grid.Row="2" Text="Reference / Order #:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SaleData.SaleID}" FontSize="12" Foreground="#111827"/>
                        </Grid>

                        <!-- Right Column: Party Info -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" HorizontalAlignment="Right">
                            <TextBlock Text="Supplier / Customer:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SaleData.PatientName}" FontSize="12" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" MaxWidth="200"/>
                            
                            <TextBlock Grid.Row="1" Text="Address / Region:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Pakistan" FontSize="12" Foreground="#111827"/>
                            
                            <TextBlock Grid.Row="2" Text="Recorded By:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SaleData.ReceptionistName}" FontSize="12" Foreground="#111827"/>
                        </Grid>
                    </Grid>

                    <!-- Line Items Table -->
                    <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              HeadersVisibility="Column" FontSize="11" MinHeight="350">
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,12"/>
                            </Style>
                            <Style Selector="DataGridCell">
                                <Setter Property="Padding" Value="12,12"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <!-- Flex Width: 35% -->
                            <DataGridTextColumn Header="Item Description" Binding="{Binding ProductName}" Width="3.5*"/>
                            <!-- Width: 12% -->
                            <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumberDisplay}" Width="1.2*"/>
                            <!-- Width: 13% -->
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDateDisplay}" Width="1.3*"/>
                            <!-- Width: 10% -->
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="1*"/>
                            <!-- Width: 15% -->
                            <DataGridTextColumn Header="Rate" Binding="{Binding ProductPrice, StringFormat='{}{0:N2}'}" Width="1.5*"/>
                            <!-- Width: 15% -->
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding NetAmount, StringFormat='{}{0:N2}'}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Right-Aligned Summary Block -->
                    <Grid ColumnDefinitions="*,300" Margin="0,16,0,0">
                        <!-- Left Side: Signatures & Notes -->
                        <StackPanel Grid.Column="0" Spacing="40" VerticalAlignment="Bottom">
                            <TextBlock Text="Total Items: {Binding DocumentTotalItems}   Total Qty: {Binding DocumentTotalQuantity}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                            <TextBlock Text="Received by: ____________________        Checked by: ____________________" FontSize="11" Foreground="#111827"/>
                        </StackPanel>

                        <!-- Right Side: Financial Summary -->
                        <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Sub Total:" FontSize="12" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DocumentSubTotal, StringFormat='Rs. {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#111827"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Taxes / Discounts:" FontSize="12" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DocumentDiscountAmount, StringFormat='Rs. {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444"/>
                                </Grid>
                                <Separator Background="#E5E7EB" Margin="0,4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Net Grand Total:" FontSize="16" FontWeight="ExtraBold" Foreground="#111827"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DocumentGrandTotal, StringFormat='Rs. {0:N2}'}" FontSize="16" FontWeight="ExtraBold" Foreground="#111827"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Footer Warranty -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" CornerRadius="4" Padding="12" Margin="0,24,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Being a person resident in Pakistan carrying on business at the address shown above under the name of Al Mustafa Distribution Pvt Ltd do hereby give this warranty that the drugs invoice as sold by us, do not contravene in any way the provisions of section 18 of the Drug Act 1976." TextWrapping="Wrap" FontSize="10" Foreground="#6B7280"/>
                            <TextBlock Text="Expiry items must be informed 6 months prior to expiry. Any discrepancy please inform us immediately." TextWrapping="Wrap" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
    </UserControl.Styles>
</UserControl>
