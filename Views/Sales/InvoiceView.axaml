<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Sales"
             x:Class="ClinicSystem.UI.Views.Sales.InvoiceView"
             x:DataType="vm:InvoiceViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18">
            <Border Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <DockPanel>
                    <Button Command="{Binding GoBackCommand}" Classes="btn-secondary" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            <TextBlock Text="Back to List"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushPrimaryBlue}" VerticalAlignment="Center"/>
                        <Button Command="{Binding PrintCommand}" Classes="btn-primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                <TextBlock Text="Print / Export PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 80mm Thermal Receipt Layout (~300px) -->
            <Border Width="300" HorizontalAlignment="Center" Margin="0,0"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    Padding="12,16" BoxShadow="0 4 12 0 #11000000">
                <Border.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="Courier New, Consolas, Monospace"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </Border.Styles>
                <StackPanel Spacing="8">
                    <!-- Company Header -->
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ClinicName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ClinicAddress}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding ClinicPhone}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="================================" HorizontalAlignment="Center" Foreground="Gray"/>
                    
                    <TextBlock Text="SALE INVOICE" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="================================" HorizontalAlignment="Center" Foreground="Gray"/>

                    <!-- Meta Data -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Inv #:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaleData.InvoiceNumber}" HorizontalAlignment="Right"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SaleData.SaleDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" HorizontalAlignment="Right"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Patient:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SaleData.PatientName}" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pay Mode:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SaleData.PaymentMethod}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="================================" HorizontalAlignment="Center" Foreground="Gray"/>
                    
                    <!-- Headers -->
                    <Grid ColumnDefinitions="3*,1*,1.5*">
                        <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Total" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <TextBlock Text="--------------------------------" HorizontalAlignment="Center" Foreground="Gray"/>

                    <!-- Line Items -->
                    <ItemsControl ItemsSource="{Binding LineItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="3*,1*,1.5*">
                                        <TextBlock Grid.Column="0" Text="{Binding ProductPrice, StringFormat='{}@ {0:N2}'}" Foreground="DimGray" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding InvoiceItemTotal, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="--------------------------------" HorizontalAlignment="Center" Foreground="Gray"/>

                    <!-- Financial Summary -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DocumentTotalQuantity, StringFormat='Total Items: {0}'}" FontSize="10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="TOTAL:" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DocumentGrandTotal, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="================================" HorizontalAlignment="Center" Foreground="Gray"/>

                    <!-- Footer Warranty -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Thank you for your visit!" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ClinicName}" FontSize="9" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
    </UserControl.Styles>
</UserControl>
