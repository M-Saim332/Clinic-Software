<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Patients"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:prescvm="using:ClinicSystem.UI.ViewModels.Prescriptions"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Patients.PatientRegistryView"
             x:Name="Root"
             x:DataType="vm:PatientRegistryViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid>
        <!-- LIST VIEW -->
        <Grid IsVisible="{Binding !SaveCancelEnabled}" RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="AccountMultiple" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Patient Registry" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Manage patient records and consultation details"
                                       FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{Binding RequestDeleteAllCommand}" Classes="btn-danger" IsVisible="{Binding IsAdmin}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><materialIcons:MaterialIcon Kind="DeleteSweep" Width="18" Height="18"/><TextBlock Text="Archive All"/></StackPanel>
                        </Button>
                        <Button Command="{Binding NewCommand}" Classes="btn-primary">
                            <StackPanel Orientation="Horizontal" Spacing="8"><materialIcons:MaterialIcon Kind="AccountPlus" Width="18" Height="18"/><TextBlock Text="Add Patient"/></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Summary Cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="28,16,28,4">
                <comp:SummaryCardControl Grid.Column="0" Margin="0,0,12,0"
                    Title="Total Patients"
                    Value="{Binding TotalPatientsCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushPrimaryBlue}"/>
                <comp:SummaryCardControl Grid.Column="1" Margin="0,0,12,0"
                    Title="Active This Month"
                    Value="{Binding ActiveThisMonthCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushAmber}"/>
                <comp:SummaryCardControl Grid.Column="2" Margin="0,0,12,0"
                    Title="Waiting Today"
                    Value="{Binding WaitingTodayCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushTeal}"/>
                <comp:SummaryCardControl Grid.Column="3"
                    Title="Clinical Records"
                    Value="{Binding TotalPatientsCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushRose}"/>
            </Grid>
            
            <!-- Data Panel with Tabs -->
            <TabControl Grid.Row="2" Margin="28,12,28,24" SelectedIndex="{Binding SelectedTab}">
                
                <!-- TAB 0: WAITING PATIENTS -->
                <TabItem Header="Waiting Patients" FontSize="14" FontWeight="Medium">
                    <comp:DataTableShellControl Title="Waiting Today" RecordCount="{Binding FilteredPatients.Count}" Margin="0,12,0,0">
                        <comp:DataTableShellControl.HeaderActions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="230" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Search name, ID, phone...">
                                    <TextBox.InnerLeftContent><materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="6,0,0,0"/></TextBox.InnerLeftContent>
                                </TextBox>
                                <comp:ExportToolbarControl ReportName="Clinic_Waiting_Patients" ItemsSource="{Binding FilteredPatients}"
                                    Columns="Name:Name:2|Age:Age|Phone:Phone|Appointment Time:AppointmentTimeDisplay|Reason of Visit:ReasonOfVisit:2"/>
                            </StackPanel>
                        </comp:DataTableShellControl.HeaderActions>

                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding FilteredPatients}" SelectedItem="{Binding SelectedPatient}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.5*" MinWidth="120"/>
                                    <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="80"/>
                                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="160"/>
                                    <DataGridTextColumn Header="APPT. TIME" Binding="{Binding AppointmentTimeDisplay}" Width="140"/>
                                    <DataGridTextColumn Header="REASON OF VISIT" Binding="{Binding ReasonOfVisit}" Width="2*" MinWidth="120"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).MarkAsVisitedCommand}" CommandParameter="{Binding}" Classes="btn-success" Padding="8,4" Height="28" ToolTip.Tip="Mark Completed">
                                                        <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).ViewSpecificCommand}" CommandParameter="{Binding}" Classes="btn-secondary" Padding="8,4" Height="28" ToolTip.Tip="View">
                                                        <materialIcons:MaterialIcon Kind="Eye" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).EditSpecificCommand}" CommandParameter="{Binding}" Classes="btn-secondary" Padding="8,4" Height="28" ToolTip.Tip="Edit">
                                                        <materialIcons:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).MarkAsCancelledCommand}" CommandParameter="{Binding}" Classes="btn-danger" Padding="8,4" Height="28" ToolTip.Tip="Cancel Visit">
                                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </TabItem>

                <!-- TAB 1: VISITED TODAY -->
                <TabItem Header="Visited Today" FontSize="14" FontWeight="Medium">
                    <comp:DataTableShellControl Title="Visited Today" RecordCount="{Binding FilteredPatients.Count}" Margin="0,12,0,0">
                        <comp:DataTableShellControl.HeaderActions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="230" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Search name, ID, phone...">
                                    <TextBox.InnerLeftContent><materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="6,0,0,0"/></TextBox.InnerLeftContent>
                                </TextBox>
                                <comp:ExportToolbarControl ReportName="Clinic_Visited_Today" ItemsSource="{Binding FilteredPatients}"
                                    Columns="Name:Name:2|Age:Age|Phone:Phone|Reason of Visit:ReasonOfVisit:2|Last Visit:LastVisitDate"/>
                            </StackPanel>
                        </comp:DataTableShellControl.HeaderActions>

                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding FilteredPatients}" SelectedItem="{Binding SelectedPatient}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="90"/>
                                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="160"/>
                                    <DataGridTextColumn Header="REASON OF VISIT" Binding="{Binding ReasonOfVisit}" Width="*"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="300">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).ViewSpecificCommand}" CommandParameter="{Binding}" Classes="btn-secondary" Padding="8,4" Height="28" ToolTip.Tip="View">
                                                        <materialIcons:MaterialIcon Kind="Eye" Width="14" Height="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </TabItem>

                <!-- TAB 2: ALL PATIENTS -->
                <TabItem Header="All Patients" FontSize="14" FontWeight="Medium">
                    <comp:DataTableShellControl Title="All Patients" RecordCount="{Binding FilteredPatients.Count}" Margin="0,12,0,0">
                        <comp:DataTableShellControl.HeaderActions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="230" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Search name, ID, phone...">
                                    <TextBox.InnerLeftContent><materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="6,0,0,0"/></TextBox.InnerLeftContent>
                                </TextBox>
                                <comp:ExportToolbarControl ReportName="Clinic_All_Patients" ItemsSource="{Binding FilteredPatients}"
                                    Columns="Patient ID:PatientID|Name:Name:2|Age:Age|Gender:Gender|Phone:Phone|Reason of Visit:ReasonOfVisit:2|Status:VisitStatus|Last Visit:LastVisitDate"/>
                            </StackPanel>
                        </comp:DataTableShellControl.HeaderActions>

                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding FilteredPatients}" SelectedItem="{Binding SelectedPatient}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="90"/>
                                    <DataGridTextColumn Header="GENDER" Binding="{Binding Gender}" Width="120"/>
                                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="160"/>
                                    <DataGridTextColumn Header="REASON OF VISIT" Binding="{Binding ReasonOfVisit}" Width="*"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="300">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).ViewSpecificCommand}" CommandParameter="{Binding}" Classes="btn-secondary" Padding="8,4" Height="28" ToolTip.Tip="View">
                                                        <materialIcons:MaterialIcon Kind="Eye" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).EditSpecificCommand}" CommandParameter="{Binding}" Classes="btn-secondary" Padding="8,4" Height="28" ToolTip.Tip="Edit">
                                                        <materialIcons:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Command="{Binding $parent[UserControl].((vm:PatientRegistryViewModel)DataContext).DeleteSpecificCommand}" CommandParameter="{Binding}" Classes="btn-danger" Padding="8,4" Height="28" ToolTip.Tip="Delete">
                                                        <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- FORM VIEW -->
        <Grid IsVisible="{Binding SaveCancelEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="AccountMultiple" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Mode, StringFormat='{}{0} Patient'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}" FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Fill out patient details below" FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" Padding="28,24,28,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Border>
                    <StackPanel Spacing="24" Margin="0,0,0,80">
                        <StackPanel Spacing="16">
                        <TextBlock Text="PATIENT DETAILS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                   FontFamily="{DynamicResource FontLexend}"/>
                        <Separator/>
                        <!-- Grid of fields -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0" IsEnabled="{Binding !IsReadOnly}">
                            
                            <!-- Row 0: Name + Phone -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,12,16">
                                <TextBlock Text="Full Name *" Classes="label"/>
                                <TextBox Text="{Binding Name}" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="6" Margin="12,0,0,16">
                                <TextBlock Text="Phone Number" Classes="label"/>
                                <TextBox Text="{Binding Phone}" PlaceholderText="03001234567" MaxLength="11" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            
                            <!-- Row 1: Age + Gender -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="6" Margin="0,0,12,16">
                                <TextBlock Text="Age" Classes="label"/>
                                <TextBox Text="{Binding Age}" PlaceholderText="e.g. 35" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="6" Margin="12,0,0,16">
                                <TextBlock Text="Gender" Classes="label"/>
                                <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" PlaceholderText="Select gender..." HorizontalAlignment="Stretch" IsEnabled="{Binding !IsReadOnly}"/>
                            </StackPanel>

                            <!-- Row 2: CNIC + Appointment Time -->
                            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="6" Margin="0,0,12,16">
                                <TextBlock Text="CNIC" Classes="label"/>
                                <TextBox Text="{Binding CNIC}" PlaceholderText="3520212345671" MaxLength="13" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="2" Spacing="6" Margin="12,0,0,16">
                                <TextBlock Text="Appointment Time (Optional)" Classes="label"/>
                                <TimePicker SelectedTime="{Binding NextAppointmentTime}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsReadOnly}"/>
                            </StackPanel>

                            <!-- Row 3: Address (full width) -->
                            <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Spacing="6" Margin="0,0,0,16">
                                <TextBlock Text="Address" Classes="label"/>
                                <TextBox Text="{Binding Address}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            
                            <!-- Row 4: clinical context and merged history -->
                            <StackPanel Grid.Column="0" Grid.Row="4" Spacing="6" Margin="0,0,12,16">
                                <TextBlock Text="Reason of Visit" Classes="label"/>
                                <TextBox Text="{Binding ReasonOfVisit}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,10" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="4" Spacing="6" Margin="12,0,0,16">
                                <TextBlock Text="Consultation" Classes="label"/>
                                <TextBlock Text="Select medicines from the pharma catalog and review linked visit history below." TextWrapping="Wrap" Foreground="{DynamicResource BrushInk500}"/>
                            </StackPanel>
                            
                        </Grid>

                        <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="18" IsVisible="{Binding ShowDrugSelection}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="DRUG SELECTION" FontWeight="Bold" Foreground="{DynamicResource BrushInk900}"/>
                                <Grid ColumnDefinitions="3*,1.2*,2*,Auto" ColumnSpacing="8" IsEnabled="{Binding !IsReadOnly}">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <comp:SearchableComboBoxControl Text="{Binding DrugSearch}" ItemsSource="{Binding FilteredDrugs}" SelectedItem="{Binding SelectedDrug}"
                                            DisplayMemberPath="Name" DetailMemberPath="PrescriptionSearchDetail" Placeholder="Search by drug name or product code..."/>
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1" Value="{Binding DrugQuantity}" Minimum="1" MinWidth="60" VerticalAlignment="Bottom"/>
                                    <TextBox Grid.Column="2" Text="{Binding Dosage}" PlaceholderText="Dosage / directions" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="3" Command="{Binding AddDrugCommand}" Classes="btn-secondary" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                            <TextBlock Text="Add"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Prescribed Medicines" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk800}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedDrugs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="prescvm:PrescriptionItemRow">
                                                    <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk900}"/>
                                                                <TextBlock Text="{Binding Dosage}" Foreground="{DynamicResource BrushInk600}" FontSize="12"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='Qty {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryBlue}" VerticalAlignment="Center" Margin="12,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding RateDisplay}" Foreground="{DynamicResource BrushInk500}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <Button Grid.Column="3"
                                                                    Command="{Binding #Root.((vm:PatientRegistryViewModel)DataContext).RemoveDrugCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="btn-ghost" Padding="8,0" Height="28" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Visit History Card (collapsible) -->
                        <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushPrimaryBlue}" BorderThickness="1.5" CornerRadius="10" Padding="20" IsVisible="{Binding SaveCancelEnabled}">
                            <StackPanel Spacing="14">
                                <!-- Header row (always shown) -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource BrushBlue50}" Margin="0,0,10,0">
                                        <materialIcons:MaterialIcon Kind="History" Width="18" Height="18" Foreground="{DynamicResource BrushPrimaryBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="VISIT HISTORY" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushInk900}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Command="{Binding ToggleVisitHistoryCommand}" Classes="btn-ghost" Padding="10,4" Height="30">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16"
                                                IsVisible="{Binding !IsVisitHistoryExpanded}"
                                                Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="16" Height="16"
                                                IsVisible="{Binding IsVisitHistoryExpanded}"
                                                Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                            <TextBlock Text="{Binding IsVisitHistoryExpanded, StringFormat={}{0}}" IsVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Collapsed state: badge shown when history is hidden -->
                                <Border IsVisible="{Binding !IsVisitHistoryExpanded}"
                                        Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="14,10">
                                    <TextBlock Foreground="{DynamicResource BrushInk500}" FontSize="13" FontStyle="Italic"
                                               Text="🕒 New Patient — No Prior History  ·  Click ▲ to expand visit log"/>
                                </Border>

                                <!-- Expanded state: full visit items -->
                                <ItemsControl ItemsSource="{Binding VisitHistory}" IsVisible="{Binding IsVisitHistoryExpanded}">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:Prescription">
                                        <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{Binding VisitDateDisplay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushInk900}"/>
                                                <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Primary Diagnosis / Reason" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk600}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PrimaryReasonDisplay}" TextWrapping="Wrap" Foreground="{DynamicResource BrushInk900}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Prescribed Medicines" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk600}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MedicinesSummary}" TextWrapping="Wrap" Foreground="{DynamicResource BrushInk900}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Doctor / Attending Notes" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk600}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DoctorNotesDisplay}" TextWrapping="Wrap" Foreground="{DynamicResource BrushInk900}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer -->
            <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Grid.Row="2" Padding="28,16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    
                    <!-- Column 0: Helper / Status Text (FAR LEFT) -->
                    <TextBlock FontSize="12" Foreground="#6B7280" Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,16,0" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusMessage}"/>

                    <!-- Column 1: Back to Patients (RIGHT GROUP) -->
                    <Button Classes="btn-secondary" Command="{Binding CancelCommand}" Grid.Column="1" Height="38" Margin="0,0,8,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            <TextBlock Text="Back to Patients" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Column 2: Toggle Visit History -->
                    <Button Classes="btn-secondary" Command="{Binding ToggleVisitHistoryCommand}" Grid.Column="2" Height="38" Margin="0,0,8,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="History" Width="16" Height="16"/>
                            <TextBlock Text="Toggle Visit History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Column 3: Print Prescription -->
                    <Button Classes="btn-blue-outline" Command="{Binding PrintClinicalSummaryCommand}" Grid.Column="3" Height="38" IsEnabled="{Binding CanUsePrescriptionActions}" IsVisible="{Binding SaveCancelEnabled}" Margin="0,0,8,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Printer" Width="16" Height="16"/>
                            <TextBlock Text="Print Prescription"/>
                        </StackPanel>
                    </Button>

                    <!-- Column 4: Send to Pharmacist -->
                    <Button Classes="btn-primary" Command="{Binding SendToPharmacistCommand}" Grid.Column="4" Height="38" IsEnabled="{Binding CanUsePrescriptionActions}" IsVisible="{Binding SaveCancelEnabled}" Margin="0,0,8,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Send" Width="16" Height="16"/>
                            <TextBlock Text="Send to Pharmacist"/>
                        </StackPanel>
                    </Button>

                    <!-- Column 5: Primary Save Patient -->
                    <Button Classes="btn-primary" Command="{Binding SaveCommand}" Grid.Column="5" Height="38" Padding="16,0" IsVisible="{Binding CanSavePatient}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
                            <TextBlock Text="Save Patient Only" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                </Grid>
            </Border>
        </Grid>

        <Border IsVisible="{Binding ShowDeleteAllConfirm}" Background="#80000000" ZIndex="200">
            <Border Background="{DynamicResource BrushCardBackground}" CornerRadius="12" Padding="28" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Archive all patients?" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="All active patients will be hidden. Their appointments, prescriptions, sales, and report history will remain stored." TextWrapping="Wrap" Foreground="{DynamicResource BrushInk600}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelDeleteAllCommand}" Classes="btn-secondary" Content="Cancel"/>
                        <Button Command="{Binding ConfirmDeleteAllCommand}" Classes="btn-danger" Content="Archive All"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-blue-outline">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk600}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource BrushRose}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BE123C"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-success">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.40"/>
        </Style>
    </UserControl.Styles>
</UserControl>
