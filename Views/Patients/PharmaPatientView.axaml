<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ClinicSystem.UI.ViewModels.Patients" x:Class="ClinicSystem.UI.Views.Patients.PharmaPatientView"
 x:DataType="vm:PharmaPatientViewModel">
 <Grid ColumnDefinitions="360,*" Margin="24" ColumnSpacing="20">
  <Border Classes="card" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Pharma Patient" FontSize="20" FontWeight="Bold"/>
   <TextBox Text="{Binding Name}" PlaceholderText="Name"/><TextBox Text="{Binding Phone}" PlaceholderText="Phone"/>
   <TextBox Text="{Binding CNIC}" PlaceholderText="CNIC (optional)"/><Button Command="{Binding SaveCommand}" Content="Save Pharma Patient"/>
   <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></StackPanel></Border>
  <DataGrid Grid.Column="1" ItemsSource="{Binding Patients}" AutoGenerateColumns="False" IsReadOnly="True">
   <DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="160"/><DataGridTextColumn Header="CNIC" Binding="{Binding CNIC}" Width="180"/></DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
