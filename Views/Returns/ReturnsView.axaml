<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Returns"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Returns.ReturnsView"
             x:DataType="vm:ReturnsViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
            BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
          <materialIcons:MaterialIcon Kind="KeyboardReturn" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Returns" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushInk900}"/>
          <TextBlock Text="Process patient refunds and supplier credits, or browse the return ledger"
                     FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="28,20">
      <TabItem Header="Process Return">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="3*,*" ColumnSpacing="20">
            <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="20"
                    DataContext="{Binding ProcessReturn}">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding IsDraftInvoice}">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Return Type"/>
                    <ComboBox ItemsSource="{Binding ReturnTypes}" SelectedItem="{Binding ReturnType}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding IsPatientReturn}">
                    <TextBlock Text="Patient"/>
                    <comp:SearchableComboBoxControl ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                                                     DisplayMemberPath="Name" DetailMemberPath="Phone"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding IsSupplierReturn}">
                    <TextBlock Text="Supplier"/>
                    <comp:SearchableComboBoxControl ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                                     DisplayMemberPath="Name" DetailMemberPath="SCode"/>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="5" IsVisible="{Binding IsPatientReturn}" IsEnabled="{Binding IsDraftInvoice}">
                  <TextBlock Text="Invoice No (optional)" Foreground="{DynamicResource BrushInk600}" FontSize="12"/>
                  <comp:SearchableComboBoxControl ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                                                   DisplayMemberPath="InvoiceNumber" DetailMemberPath="PatientName"/>
                </StackPanel>

                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushLine}"
                        BorderThickness="1" CornerRadius="8" Padding="12" IsEnabled="{Binding IsDraftInvoice}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="SELECT MEDICINES" FontSize="11" FontWeight="Bold" LetterSpacing="1.2"
                                   Foreground="{DynamicResource BrushInk400}"/>
                        <Border Background="{DynamicResource BrushBlue50}" CornerRadius="4" Padding="6,2">
                          <TextBlock Text="{Binding GlobalUnitLabel, StringFormat='Qty in: {0}'}" FontSize="11"
                                     Foreground="{DynamicResource BrushPrimaryBlue}"/>
                        </Border>
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding AddRowCommand}" Content="+" Width="32" Height="32"
                              Padding="0" Classes="btn-primary" FontSize="18"/>
                    </Grid>

                    <Grid ColumnDefinitions="2*,120,88,120,34">
                      <TextBlock Text="MEDICINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                      <TextBlock Grid.Column="1" Text="QTY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                      <TextBlock Grid.Column="2" Text="UNIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                      <TextBlock Grid.Column="3" Text="REFUND" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushInk400}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ReturnRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushLine}"
                                  BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="2*,120,88,120,34">
                                <comp:SearchableComboBoxControl Grid.Column="0" ItemsSource="{Binding $parent[UserControl].DataContext.ProcessReturn.Products}"
                                                                 SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name"
                                                                 DetailMemberPath="Type" Placeholder="Search medicine..."/>
                                <NumericUpDown Grid.Column="1" Value="{Binding EnteredQuantity}" Minimum="1"
                                               Maximum="{Binding MaxQuantity}" FormatString="0" Width="110"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource BrushBlue50}" CornerRadius="4" Padding="6,4">
                                  <TextBlock Text="{Binding UnitLabel}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                             Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding RefundAmount, StringFormat='Rs. {0:N2}'}"
                                           VerticalAlignment="Center" FontWeight="Bold" Margin="8,0"/>
                                <Button Grid.Column="4" Command="{Binding $parent[UserControl].DataContext.ProcessReturn.RemoveRowCommand}"
                                        CommandParameter="{Binding}" Content="−" Width="28" Height="28" Padding="0" Classes="btn-secondary"/>
                              </Grid>
                              <ComboBox ItemsSource="{Binding SelectedProduct.StockEntries}" SelectedItem="{Binding SelectedBatch}"
                                        DisplayMemberBinding="{Binding BatchDisplay}" MinHeight="30"
                                        IsVisible="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                              <TextBlock Text="{Binding StockInfo}" FontSize="11" Foreground="{DynamicResource BrushInk500}"
                                         IsVisible="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding AddReturnItemCommand}" Content="✓  Add to Invoice" Classes="btn-secondary"
                            IsVisible="{Binding IsDraftInvoice}"/>
                  </StackPanel>
                </Border>

                <TextBox Text="{Binding Reason}" PlaceholderText="Reason (optional)" IsEnabled="{Binding IsDraftInvoice}"/>
                <TextBox Text="{Binding Notes}" PlaceholderText="Additional notes (optional)" AcceptsReturn="True"
                         Height="55" TextWrapping="Wrap" IsEnabled="{Binding IsDraftInvoice}"/>

                <DataGrid ItemsSource="{Binding ReturnItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="190"
                          CanUserResizeColumns="True" HorizontalAlignment="Stretch" GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <DataGrid.Styles>
                    <Style Selector="DataGridCell TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}" Width="2*" MinWidth="140"/>
                    <DataGridTextColumn Header="QTY / UNIT" Binding="{Binding QuantityWithUnit}" Width="1.1*" MinWidth="100"/>
                    <DataGridTextColumn Header="PIECES" Binding="{Binding Quantity}" Width="0.8*" MinWidth="80"/>
                    <DataGridTextColumn Header="REFUND" Binding="{Binding RefundAmount, StringFormat='Rs. {0:N2}'}" Width="1.2*" MinWidth="115"/>
                  </DataGrid.Columns>
                </DataGrid>

                <Border Background="{DynamicResource BrushBlue50}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding StockQuantity, StringFormat='Total pieces adjusted: {0}'}"/>
                    <TextBlock Text="{Binding RefundAmount, StringFormat='Refund / credit: Rs. {0:N2}'}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushRose}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Command="{Binding CheckInvoiceCommand}" Content="Check Invoice" Classes="btn-primary" IsVisible="{Binding IsDraftInvoice}"/>
                  <Button Command="{Binding EditDraftCommand}" Content="Edit Draft" Classes="btn-secondary" IsVisible="{Binding IsCheckingInvoice}"/>
                  <Button Command="{Binding PostReturnCommand}" Content="Post Invoice" Classes="btn-primary" IsVisible="{Binding IsCheckingInvoice}"/>
                  <Button Command="{Binding NewReturnCommand}" Content="New Return" Classes="btn-secondary" IsVisible="{Binding IsPostedInvoice}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushLine}"
                    BorderThickness="1" CornerRadius="12" Padding="16" VerticalAlignment="Top" DataContext="{Binding ProcessReturn}">
              <StackPanel Spacing="10">
                <TextBlock Text="RETURN POLICY" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource BrushInk400}"/>
                <TextBlock Text="Patient returns restore stock in pieces at the per-piece MRP." TextWrapping="Wrap"/>
                <TextBlock Text="Supplier returns deduct stock in packs at the full Pack TP." TextWrapping="Wrap"/>
                <TextBlock Text="Check Invoice is a preview only. Stock changes only after Post Invoice." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Return History">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,12" DataContext="{Binding ReturnHistory}">
            <TextBox Width="240" Text="{Binding SearchTerm}" PlaceholderText="Search returns..."/>
            <Button Command="{Binding GenerateReturnInvoiceCommand}" Content="Save as PDF" Classes="btn-secondary"/>
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushLine}"
                  BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <DataGrid x:Name="ReturnHistoryGrid" ItemsSource="{Binding ReturnHistory.Returns}" SelectedItem="{Binding ReturnHistory.SelectedReturn}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                      HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True"
                      CanUserSortColumns="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
              <DataGrid.Styles>
                <Style Selector="DataGridCell TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Style>
              </DataGrid.Styles>
              <DataGrid.Columns>
                <DataGridTextColumn Header="RETURN NO" Binding="{Binding ReturnNo}" Width="140" MinWidth="140"/>
                <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding CreatedAt, StringFormat=\{0:dd MMM yyyy HH:mm\}}" Width="160" MinWidth="160"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding ReturnType}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductSummary}" Width="150" MinWidth="150"/>
                <DataGridTextColumn Header="QTY / UNIT" Binding="{Binding QuantityWithUnit}" Width="100" MinWidth="100"/>
                <DataGridTextColumn Header="PATIENT / SUPPLIER" Binding="{Binding CounterpartyName}" Width="140" MinWidth="140"/>
                <DataGridTextColumn Header="REFUND AMOUNT" Binding="{Binding RefundAmount, StringFormat='Rs. {0:N2}'}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="PROCESSED BY" Binding="{Binding CreatedByName}" Width="140" MinWidth="140"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <TextBlock Grid.Row="2" Text="{Binding ReturnHistory.StatusMessage}" Foreground="{DynamicResource BrushRose}" Margin="0,8"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
