<Window xmlns="https://github.com/avaloniaui"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClinicSystem.UI.ViewModels"
        xmlns:userviews="using:ClinicSystem.UI.Views.Users"
        xmlns:comp="using:ClinicSystem.UI.Views.Components"
        x:Class="ClinicSystem.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Title="Clinic Management System"
        Width="1280" Height="700"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Icon="avares://ClinicSystem.UI/Assets/hospital_logo.png">

  <Grid ColumnDefinitions="Auto,*">
    <comp:SidebarControl Grid.Column="0"/>


    <!-- ═══════════════════════════════════════════════════════
         RIGHT: TOP BAR + CONTENT
         ═══════════════════════════════════════════════════════ -->
    <Grid Grid.Column="1" RowDefinitions="60,Auto,*,Auto">

      <!-- Top bar -->
      <Border Grid.Row="0" Background="{DynamicResource ThemeContentBackgroundBrush}"
              BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="24,0">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <!-- Left: Page Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeContentForegroundBrush}" FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Middle: Global Search Bar -->
          <TextBox Grid.Column="1" Width="360" HorizontalAlignment="Center" Text="{Binding SearchText}" PlaceholderText="Search patients, appointments, etc..." Background="{DynamicResource ThemeInputBackgroundBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BrushLine}">
              <TextBox.InnerLeftContent>
                  <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource ThemeSubtleForegroundBrush}" Margin="12,0,8,0"/>
              </TextBox.InnerLeftContent>
          </TextBox>

          <!-- Right: Notification Bell & User Profile -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
            
            <!-- Notification Bell -->
            <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8">
                <Grid>
                    <materialIcons:MaterialIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                    <!-- Notification Badge (Mocked for now) -->
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushRose}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                </Grid>
            </Button>
            
            <Border Width="1" Background="{DynamicResource BrushLine}" Height="24" VerticalAlignment="Center"/>
            
            <!-- User Profile Dropdown -->
            <Button Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="8">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Profile" Command="{Binding ShowProfileCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="AccountCircle" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Settings" Command="{Binding ShowSettingsCommand}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Logout" Command="{Binding LogoutCommand}" Foreground="{DynamicResource BrushRose}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Logout" Width="14" Height="14" Foreground="{DynamicResource BrushRose}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrushPrimaryBlue50}">
                        <TextBlock Text="{Binding CurrentUserName, StringFormat={}{0:1}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeContentForegroundBrush}"/>
                        <TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                    </StackPanel>
                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource ThemeSubtleForegroundBrush}"/>
                </StackPanel>
            </Button>
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrushEmerald}" VerticalAlignment="Center"
                    ToolTip.Tip="Database connected"/>
          </StackPanel>
        </Grid>
      </Border>




      <!-- Content area -->
      <Panel Grid.Row="2" Background="#F8FAFC">
        <ContentControl Content="{Binding CurrentPageViewModel}" Background="#F8FAFC"/>

        <!-- Loading overlay -->
        <Border IsVisible="{Binding IsLoading}"
                Background="rgba(248, 250, 252, 0.85)">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="White" BorderBrush="{DynamicResource ThemePrimaryBrush}" BorderThickness="1"
                    BoxShadow="0 4 6 -1 rgba(0,0,0,0.05)">
              <materialIcons:MaterialIcon Kind="HospitalBuilding" Width="24" Height="24"
                        Foreground="{DynamicResource ThemePrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                         Foreground="{DynamicResource ThemePrimaryBrush}" Background="#E5E7EB"/>
            <TextBlock Text="Loading data…" Foreground="#4B5563" FontSize="13"
                       HorizontalAlignment="Center" FontWeight="Medium"/>
          </StackPanel>
        </Border>

        <!-- Alert Banner Overlay -->
        <Border IsVisible="{Binding ShowAlert}" ZIndex="210" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Border Background="{DynamicResource BrushAmber50}" BorderBrush="{DynamicResource BrushAmber}" BorderThickness="1" CornerRadius="8" Padding="16,12" BoxShadow="0 4 12 0 rgba(0,0,0,0.1)">
                <DockPanel>
                    <materialIcons:MaterialIcon Kind="Alert" Width="16" Height="16" Foreground="{DynamicResource BrushAmber}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseAlertCommand}" Background="Transparent" BorderThickness="0" Padding="4" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource BrushAmber}"/>
                    </Button>
                    <TextBlock Text="{Binding AlertMessage}" Foreground="{DynamicResource BrushAmber}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- Change Password overlay wrapper -->
        <Panel IsVisible="{Binding ShowChangePassword}" ZIndex="200">
            <userviews:ChangePasswordView DataContext="{Binding ChangePasswordVM}"/>
        </Panel>

        <!-- Logout Confirmation Overlay -->
        <Border IsVisible="{Binding ShowLogoutConfirm}" Background="#80000000" ZIndex="200">
            <Border Background="{DynamicResource BrushCardBackground}" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BrushRose100}">
                            <PathIcon Data="{StaticResource IconLogout}" Width="20" Height="20" Foreground="{DynamicResource BrushRose}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sign Out" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushInk900}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushInk600}" Text="Are you sure you want to sign out of the application?"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button  Command="{Binding CancelLogoutCommand}" Background="Transparent" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        <Button  Command="{Binding ConfirmLogoutCommand}" Background="{DynamicResource BrushRose}" Foreground="White" BorderThickness="0">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Logout" Width="18" Height="18"/>
        <TextBlock Text="Sign Out" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
      </Panel>

      <!-- Status bar -->
      <Border Grid.Row="3" Background="#F8FAFC" Padding="24,6"
              BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding StatusText}" Foreground="#6B7280" FontSize="12"/>
      </Border>


    </Grid>
  </Grid>
</Window>

