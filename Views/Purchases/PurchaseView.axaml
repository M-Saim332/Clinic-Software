<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Purchases"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Purchases.PurchaseView"
             x:DataType="vm:PurchaseViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid>
        <!-- ============================================================ -->
        <!-- 1. LIST/GRID VIEW (ShowForm is false)                         -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding !ShowForm}" RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Purchase Invoices" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Create and view purchase invoices from suppliers"
                                       FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button  Command="{Binding NewCommand}"
                            Classes="btn-primary" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
        <TextBlock Text="New Purchase" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                </DockPanel>
            </Border>

            <!-- Summary Cards Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="28,16,28,4">
                <comp:SummaryCardControl Grid.Column="0" Margin="0,0,12,0"
                    Title="Total Invoices"
                    Value="{Binding TotalInvoicesCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushPrimaryBlue}"/>
                <comp:SummaryCardControl Grid.Column="1" Margin="0,0,12,0"
                    Title="Purchases Amount"
                    Value="{Binding TotalPurchasesAmount, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushTeal}"/>
                <comp:SummaryCardControl Grid.Column="2" Margin="0,0,12,0"
                    Title="Total Suppliers"
                    Value="{Binding TotalSuppliersCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushAmber}"/>
                <comp:SummaryCardControl Grid.Column="3"
                    Title="Avg Invoice Value"
                    Value="{Binding AverageInvoiceValue, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushRose}"/>
            </Grid>

            <!-- Data Panel -->
            <Grid Grid.Row="2" Margin="28,12,28,24">
                <comp:DataTableShellControl Title="Purchase History" RecordCount="{Binding Purchases.Count}">
                    <comp:DataTableShellControl.HeaderActions>
                        <comp:ExportToolbarControl ReportName="Purchases_List" ItemsSource="{Binding Purchases}"
                            Columns="Invoice No:InvoiceNumber|Date:PurchaseDate|Supplier:SupplierName:2|Created By:CreatedByName|Total Amount:TotalAmount"/>
                    </comp:DataTableShellControl.HeaderActions>
                    <comp:DataTableShellControl.FilterToolbar>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Command="{Binding ViewDetailsCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=PurchaseHistoryGrid}"
                                    IsEnabled="{Binding SelectedItem, ElementName=PurchaseHistoryGrid, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Classes="btn-secondary">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Eye" Width="18" Height="18"/>
        <TextBlock Text="View Details" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        </StackPanel>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid x:Name="PurchaseHistoryGrid" ItemsSource="{Binding Purchases}"
                                  SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE NO." Binding="{Binding InvoiceNumber}" Width="200"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat=\{0:dd MMM yyyy\}}" Width="180"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="CREATED BY" Binding="{Binding CreatedByName}" Width="150"/>
                                <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 2. FORM / DETAIL VIEW (ShowForm is true)                     -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding ShowForm}" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Mode, StringFormat='{}{0} Purchase Invoice'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}" FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Enter details and items for this invoice" FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Printable document view -->
            <Grid Grid.Row="1" IsVisible="{Binding IsViewingInvoiceDocument}" RowDefinitions="*,Auto">

                <!-- A4 Paper Canvas -->
                <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="28,24,28,0" Spacing="0" HorizontalAlignment="Center">
                        <Border Width="850" MinHeight="1120" HorizontalAlignment="Center"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="2" Padding="48,40" BoxShadow="0 4 16 0 #18000000">
                            <StackPanel Spacing="20">

                                <!-- Pharmacy Header Banner -->
                                <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ClinicName}" FontSize="22" FontWeight="ExtraBold" Foreground="#111827" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClinicAddress}" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClinicPhone}" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Document Title Bar -->
                                <Border BorderBrush="#111827" BorderThickness="0,2,0,2" Padding="0,10" HorizontalAlignment="Stretch">
                                    <TextBlock Text="PURCHASE INVOICE — INCOMING STOCK RECEIPT" FontSize="14" FontWeight="ExtraBold"
                                               LetterSpacing="1.5" Foreground="#111827" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Clean 2-Column Header Block -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="2" Margin="0,4,0,4">
                                    <Grid ColumnDefinitions="*,1,*">

                                        <!-- Left: Invoice Info -->
                                        <Grid Grid.Column="0" Margin="20,16"
                                              ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Text="Invoice #" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}" FontSize="12" FontWeight="Bold" Foreground="#111827"/>

                                            <TextBlock Grid.Row="1" Text="Invoice Date" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" Foreground="#111827"/>

                                            <TextBlock Grid.Row="2" Text="Ref. Order #" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceNumber}" FontSize="12" Foreground="#111827"/>
                                        </Grid>

                                        <!-- Divider -->
                                        <Border Grid.Column="1" Background="#E5E7EB" Width="1"/>

                                        <!-- Right: Party Info -->
                                        <Grid Grid.Column="2" Margin="20,16"
                                              ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Text="Supplier Name" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SupplierDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1" Text="Supplier Address" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Pakistan" FontSize="12" Foreground="#111827"/>

                                            <TextBlock Grid.Row="2" Text="Recorded By" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LoggedInUserName}" FontSize="12" Foreground="#111827"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- High-Readability Line Items Table -->
                                <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E5E7EB"
                                          VerticalGridLinesBrush="#E5E7EB"
                                          HeadersVisibility="Column" FontSize="12" MinHeight="380">
                                    <DataGrid.Styles>
                                        <Style Selector="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="10,12"/>
                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        </Style>
                                        <Style Selector="DataGridCell">
                                            <Setter Property="Padding" Value="10,11"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#111827"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGrid.Styles>
                                    <DataGrid.Columns>
                                        <!-- Sr. (min-width: 40px, centered) -->
                                        <DataGridTemplateColumn MinWidth="45" Width="45">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Sr." TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ItemCodeDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Item Description (min-width: 220px, left-aligned) -->
                                        <DataGridTemplateColumn MinWidth="220" Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Item Description" TextWrapping="NoWrap" HorizontalAlignment="Left"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Margin="4,0,4,0" TextWrapping="NoWrap"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>


                                        <!-- Expiry Date (min-width: 90px, centered) -->
                                        <DataGridTemplateColumn MinWidth="95" Width="95">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Expiry Date" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ExpiryDateDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Qty (min-width: 60px, right-aligned) -->
                                        <DataGridTemplateColumn MinWidth="65" Width="65">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Qty" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PackageQuantity}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Bonus (min-width: 60px, right-aligned) -->
                                        <DataGridTemplateColumn MinWidth="65" Width="65">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Bonus" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding BonusQuantity}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Rate (T.P) (min-width: 90px, right-aligned) -->
                                        <DataGridTemplateColumn MinWidth="95" Width="95">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Rate (T.P)" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PurchasePrice, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- MRP (min-width: 90px, right-aligned) -->
                                        <DataGridTemplateColumn MinWidth="95" Width="95">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="MRP" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PackMRP, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Line Total (min-width: 110px, right-aligned) -->
                                        <DataGridTemplateColumn MinWidth="110" Width="115">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Line Total" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LineNetTotal, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Financial Calculation Engine & Totals Block -->
                                <Grid ColumnDefinitions="*,320" Margin="0,8,0,0">
                                    <!-- Left: Summary counts -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="4">
                                        <TextBlock Text="{Binding DocumentTotalItems, StringFormat='Total Items: {0}'}" FontSize="11" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding DocumentTotalQuantity, StringFormat='Total Qty: {0}'}" FontSize="11" Foreground="#6B7280"/>
                                    </StackPanel>

                                    <!-- Right: Financial summary -->
                                    <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="20,16" Background="#FAFAFA">
                                        <StackPanel Spacing="10">
                                            <!-- 1. Gross Amount -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Gross Amount (Base)" FontSize="12" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DocumentGrossAmount, StringFormat='Rs. {0:N2}'}" FontSize="12" Foreground="#111827" FontWeight="SemiBold"/>
                                            </Grid>
                                            <!-- 2. Discount -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ExtraDiscount, StringFormat='Discount ({0:N2}%)'}" FontSize="12" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DocumentDiscountAmount, StringFormat='-Rs. {0:N2}'}" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold"/>
                                            </Grid>
                                            <!-- 3. Advance Tax -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ATax, StringFormat='Advance Tax ({0:N2}%)'}" FontSize="12" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DocumentAdvanceWHTax, StringFormat='+Rs. {0:N2}'}" FontSize="12" Foreground="#111827" FontWeight="SemiBold"/>
                                            </Grid>
                                            <!-- 4. Company Sales Tax -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding CompanySalesTax, StringFormat='Sales Tax ({0:N2}%)'}" FontSize="12" Foreground="#4B5563"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DocumentTaxAmount, StringFormat='+Rs. {0:N2}'}" FontSize="12" Foreground="#111827" FontWeight="SemiBold"/>
                                            </Grid>
                                            <!-- 5. NET GRAND TOTAL -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="NET GRAND TOTAL (FINAL)" FontSize="15" FontWeight="ExtraBold" Foreground="#111827"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DocumentNetTotal, StringFormat='Rs. {0:N2}'}" FontSize="15" FontWeight="ExtraBold" Foreground="#111827"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                        <!-- Bottom padding inside scroll area -->
                        <Border Height="32"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Controls Bar -->
                <Border Grid.Row="1" Background="{DynamicResource BrushCardBackground}"
                        BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: Back button -->
                        <Button Grid.Column="0" Command="{Binding CancelCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/>
                                <TextBlock Text="Back"/>
                            </StackPanel>
                        </Button>

                        <!-- Center: Status indicator + message -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="FileDocument" Width="16" Height="16" Foreground="{DynamicResource BrushInk600}"/>
                            <TextBlock Text="{Binding InvoiceNumber, StringFormat='Invoice {0}'}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTeal}" VerticalAlignment="Center"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- Right: Status badge + action buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <!-- POSTED badge -->
                            <Border Background="#D1FAE5" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="12,6"
                                    IsVisible="{Binding IsPostedInvoice}">
                                <TextBlock Text="✓ POSTED" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                            </Border>
                            <!-- CHECKING badge -->
                            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,6"
                                    IsVisible="{Binding IsCheckingInvoice}">
                                <TextBlock Text="REVIEWED" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                            <!-- DRAFT badge -->
                            <Border Background="#F3F4F6" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6" Padding="12,6"
                                    IsVisible="{Binding IsDraftInvoice}">
                                <TextBlock Text="DRAFT" FontSize="12" FontWeight="Bold" Foreground="#4B5563"/>
                            </Border>
                            <!-- Post Invoice button (only when not posted) -->
                            <Button Command="{Binding PostInvoiceCommand}" Classes="btn-primary"
                                    IsVisible="{Binding !IsPostedInvoice}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Download" Width="16" Height="16"/>
                                    <TextBlock Text="Post Purchase Invoice"/>
                                </StackPanel>
                            </Button>
                            <!-- PDF button (only when posted) -->
                            <Button Command="{Binding PrintPurchaseDocumentCommand}" Classes="btn-secondary"
                                    IsVisible="{Binding IsPostedInvoice}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Printer" Width="16" Height="16"/>
                                    <TextBlock Text="Save as PDF"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Keep all form content between the fixed title and action bar scrollable. -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsViewingInvoiceDocument}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,16">

                <!-- Direct two-column form grid: invoice details on the left, line entry on the right. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="28,20,28,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- Left: Invoice Header card -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20" Margin="0,0,10,0"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="INVOICE HEADER" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <Border Background="{DynamicResource BrushBlue50}" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="{Binding LoggedInUserName, StringFormat='Recorded by: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                            </Border>
                            <!-- Keep each field in its own cell so controls use the full column width. -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                                <!-- Left column: invoice number and supplier selection -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Invoice Number" Classes="label"/>
                                    <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="{Binding !SaveCancelEnabled}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Supplier (Optional)" Classes="label"/>
                                    <comp:SearchableComboBoxControl ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                                                    Text="{Binding SupplierSearchText}" AllowCustomText="True"
                                                                    IsEnabled="{Binding SaveCancelEnabled}" DisplayMemberPath="Name" DetailMemberPath="SCode" Placeholder="Search supplier..."/>
                                    <Button Command="{Binding QuickAddSupplierCommand}" Content="Add Supplier" Classes="btn-secondary"
                                            HorizontalAlignment="Left" IsVisible="{Binding SaveCancelEnabled}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Right column: invoice date and free-text supplier name -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Date" Classes="label"/>
                                    <DatePicker SelectedDate="{Binding PurchaseDate}" IsEnabled="{Binding SaveCancelEnabled}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Supplier Name (if unlisted)" Classes="label"/>
                                    <TextBox Text="{Binding SupplierName}" IsEnabled="{Binding SaveCancelEnabled}" PlaceholderText="Type supplier if not listed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Add Line Item card -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="20" Margin="10,0,0,0"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="ADD LINE ITEM" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                           FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, StringFormat='Total: Rs. {0:N2}'}"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryBlue}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Add line items (only visible when in Add/Edit mode) -->
                            <StackPanel Spacing="10" IsVisible="{Binding SaveCancelEnabled}">
                                <!-- Product row -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                        <TextBlock Text="Product *" Classes="label"/>
                                        <comp:SearchableComboBoxControl ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                            AllowCustomText="True" Text="{Binding ProductSearchText}"
                                            DisplayMemberPath="Name" DetailMemberPath="StockDisplay" Placeholder="Search or type new product..."/>
                                        <Button Command="{Binding QuickAddProductCommand}" Content="Add Product" Classes="btn-secondary" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                        <Button Command="{Binding AddLineItemCommand}" Classes="btn-primary" Width="76">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15"/>
                                                <TextBlock Text="Add" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Batch + Expiry -->
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Batch Number (Optional)" Classes="label"/>
                                        <TextBox Text="{Binding BatchNumber}" PlaceholderText="Batch No. (optional)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="Expiry Date *" Classes="label"/>
                                        <DatePicker SelectedDate="{Binding ExpiryDate}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Wider paired inputs keep values and spinner controls readable. -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Qty / Packaging" Classes="label"/>
                                        <NumericUpDown Value="{Binding Quantity}" Minimum="1" FormatString="N0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Bonus" Classes="label"/>
                                        <NumericUpDown Value="{Binding BonusQuantity}" Minimum="0" FormatString="N0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Rate (T.P)" Classes="label" ToolTip.Tip="Supplier trade price."/>
                                        <NumericUpDown Value="{Binding PurchasePrice}" FormatString="N2" Minimum="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="MRP" Classes="label" ToolTip.Tip="Max Retail Price on box."/>
                                        <NumericUpDown Value="{Binding PackMRP}" FormatString="N2" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Disc (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding Discount}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Extra Disc (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ExtraDiscount}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Adv. Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ATax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="C.S.Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding CompanySalesTax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Live preview totals -->
                                <Border Background="{DynamicResource BrushTeal50}" CornerRadius="6" Padding="10,8">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="Gross Amount" FontSize="10" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineGrossAmountPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTeal}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Center">
                                            <TextBlock Text="Tax Total" FontSize="10" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineTaxTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAmber}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Line Net Total" FontSize="10" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineNetTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- View-only state (Mode=View, no editing) -->
                            <StackPanel Spacing="6" IsVisible="{Binding !SaveCancelEnabled}" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <materialIcons:MaterialIcon Kind="FileEye" Width="28" Height="28" Foreground="{DynamicResource BrushInk400}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Invoice Viewed" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk400}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Line items cannot be edited on a saved invoice." FontSize="12" Foreground="{DynamicResource BrushInk500}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom panel: grows with review items and stays compact while empty. -->
                <Grid Grid.Row="1" Margin="28,16,28,0" HorizontalAlignment="Stretch">
                    <comp:DataTableShellControl Title="Invoice Items" RecordCount="{Binding LineItems.Count}"
                                                CompactWhenEmpty="True" HorizontalAlignment="Stretch">
                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=\{0:dd MMM yyyy\}}" Width="110"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding PackageQuantity}" Width="65"/>
                                    <DataGridTextColumn Header="BONUS" Binding="{Binding BonusQuantity}" Width="65"/>
                                    <DataGridTextColumn Header="RATE" Binding="{Binding PurchasePrice, StringFormat='Rs. {0:N2}'}" Width="95"/>
                                    <DataGridTextColumn Header="MRP" Binding="{Binding PackMRP, StringFormat='Rs. {0:N2}'}" Width="95"/>
                                    <DataGridTextColumn Header="DISC%" Binding="{Binding ExtraDiscount}" Width="70"/>
                                    <DataGridTextColumn Header="SUB TOTAL" Binding="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" Width="110"/>
                                    <DataGridTextColumn Header="ADV.TAX" Binding="{Binding ATax}" Width="75"/>
                                    <DataGridTextColumn Header="C.S.TAX" Binding="{Binding CompanySalesTax}" Width="75"/>
                                    <DataGridTextColumn Header="NET AMOUNT" Binding="{Binding LineNetTotal, StringFormat='Rs. {0:N2}'}" Width="115"/>
                                    <DataGridTemplateColumn Width="46" IsVisible="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).SaveCancelEnabled}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).RemoveLineItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource BrushRose}"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </Grid>
            </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" IsVisible="{Binding !IsViewingInvoiceDocument}"
                    Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="2">
                        <!-- Checking/reviewed state banner -->
                        <Border Background="#D1FAE5" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="14,6"
                                IsVisible="{Binding IsCheckingInvoice}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#065F46"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushRose}"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                   IsVisible="{Binding !IsCheckingInvoice}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding CancelCommand}" Classes="btn-secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                                <TextBlock Text="Back" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="✓ POSTED" IsVisible="{Binding IsPostedInvoice}" FontWeight="Bold" Foreground="{DynamicResource BrushTeal}" VerticalAlignment="Center"/>
                        <Button Command="{Binding SaveAndCheckCommand}" Classes="btn-secondary" IsVisible="{Binding !IsPostedInvoice}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ClipboardList" Width="18" Height="18"/>
                                <TextBlock Text="Check Invoice" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PostInvoiceCommand}" Classes="btn-primary" IsVisible="{Binding !IsPostedInvoice}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Download" Width="18" Height="18"/>
                                <TextBlock Text="Post Purchase Invoice" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk600}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource BrushRose}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BE123C"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.40"/>
        </Style>
    </UserControl.Styles>
</UserControl>
