<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Purchases"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Purchases.PurchaseView"
             x:DataType="vm:PurchaseViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid>
        <!-- ============================================================ -->
        <!-- 1. LIST/GRID VIEW (ShowForm is false)                         -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding !ShowForm}" RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Purchase Invoices" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Create and view purchase invoices from suppliers"
                                       FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button  Command="{Binding NewCommand}"
                            Classes="btn-primary" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
        <TextBlock Text="New Purchase" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                </DockPanel>
            </Border>

            <!-- Summary Cards Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="28,16,28,4">
                <comp:SummaryCardControl Grid.Column="0" Margin="0,0,12,0"
                    Title="Total Invoices"
                    Value="{Binding TotalInvoicesCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushPrimaryBlue}"/>
                <comp:SummaryCardControl Grid.Column="1" Margin="0,0,12,0"
                    Title="Purchases Amount"
                    Value="{Binding TotalPurchasesAmount, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushTeal}"/>
                <comp:SummaryCardControl Grid.Column="2" Margin="0,0,12,0"
                    Title="Total Suppliers"
                    Value="{Binding TotalSuppliersCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushAmber}"/>
                <comp:SummaryCardControl Grid.Column="3"
                    Title="Avg Invoice Value"
                    Value="{Binding AverageInvoiceValue, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushRose}"/>
            </Grid>

            <!-- Data Panel -->
            <Grid Grid.Row="2" Margin="28,12,28,24">
                <comp:DataTableShellControl Title="Purchase History" RecordCount="{Binding Purchases.Count}">
                    <comp:DataTableShellControl.HeaderActions>
                        <comp:ExportToolbarControl ReportName="Purchases_List" ItemsSource="{Binding Purchases}"
                            Columns="Invoice No:InvoiceNumber|Date:PurchaseDate|Supplier:SupplierName:2|Created By:CreatedByName|Total Amount:TotalAmount"/>
                    </comp:DataTableShellControl.HeaderActions>
                    <comp:DataTableShellControl.FilterToolbar>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button  Command="{Binding ViewDetailsCommand}"
                                    IsEnabled="{Binding SelectedPurchase, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Classes="btn-secondary">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Eye" Width="18" Height="18"/>
        <TextBlock Text="View Details" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        </StackPanel>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE NO." Binding="{Binding InvoiceNumber}" Width="200"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat=\{0:dd MMM yyyy\}}" Width="180"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="CREATED BY" Binding="{Binding CreatedByName}" Width="150"/>
                                <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 2. FORM / DETAIL VIEW (ShowForm is true)                     -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding ShowForm}" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Mode, StringFormat='{}{0} Purchase Invoice'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}" FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Enter details and items for this invoice" FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Printable document view -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsViewingInvoiceDocument}">
                <StackPanel Margin="28,24" Spacing="18">
                    <Border Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Button Command="{Binding CancelCommand}" Classes="btn-secondary" DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                                    <TextBlock Text="Back to List"/>
                                </StackPanel>
                            </Button>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Command="{Binding PrintPurchaseDocumentCommand}" Classes="btn-primary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                        <TextBlock Text="Print / Export PDF"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding EmailPurchaseDocumentCommand}" Classes="btn-secondary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18"/>
                                        <TextBlock Text="Email Document"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Width="850" MinHeight="1202" HorizontalAlignment="Center"
                            Background="White" BorderBrush="#111827" BorderThickness="1"
                            CornerRadius="0" Padding="24" BoxShadow="0 8 24 0 #22000000">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Al Mustafa Distribution Pvt Ltd" FontSize="22" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                                <TextBlock Text="Main Wholesale Medicine Market, Pakistan" FontSize="11" Foreground="#111827" HorizontalAlignment="Center"/>
                                <TextBlock Text="Phone: 021-0000000, 0300-0000000" FontSize="11" Foreground="#111827" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border BorderBrush="#111827" BorderThickness="1" Padding="18,4" HorizontalAlignment="Center">
                                <TextBlock Text="Purchase Invoice" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                            </Border>

                            <Border BorderBrush="#111827" BorderThickness="1" Padding="8">
                                <Grid ColumnDefinitions="*,*,1.35*" ColumnSpacing="10">
                                    <Grid Grid.Column="0" ColumnDefinitions="95,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                                        <TextBlock Text="Invoice #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}" FontSize="9"/>
                                        <TextBlock Grid.Row="1" Text="Sale Order #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="2" Text="DSS Id" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="2" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="3" Text="Reference No" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InvoiceNumber}" FontSize="9"/>
                                        <TextBlock Grid.Row="4" Text="Booking Man" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LoggedInUserName}" FontSize="9"/>
                                        <TextBlock Grid.Row="5" Text="Ship To" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Warehouse" FontSize="9"/>
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="105,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                                        <TextBlock Text="Invoice Date" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="9"/>
                                        <TextBlock Grid.Row="1" Text="Sale Order Type" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Purchase" FontSize="9"/>
                                        <TextBlock Grid.Row="2" Text="Due Date" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="9"/>
                                        <TextBlock Grid.Row="3" Text="Reference Date" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="9"/>
                                        <TextBlock Grid.Row="4" Text="Delivery Man" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Warehouse Receiving" FontSize="9"/>
                                        <TextBlock Grid.Row="5" Text="Remarks" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DocumentStatus}" FontSize="9"/>
                                    </Grid>
                                    <Grid Grid.Column="2" ColumnDefinitions="125,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                                        <TextBlock Text="Supplier Code &amp; Name" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding SupplierDisplayName}" TextWrapping="Wrap" FontSize="9"/>
                                        <TextBlock Grid.Row="1" Text="Region" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Pakistan" FontSize="9"/>
                                        <TextBlock Grid.Row="2" Text="Phone" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="2" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="3" Text="Address" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="3" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="4" Text="Filer Status" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="4" Grid.Column="1" Text="No" FontSize="9"/>
                                        <TextBlock Grid.Row="5" Text="License #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="5" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="6" Text="NTN #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="6" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="7" Text="GST #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="7" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="8" Text="CNIC #" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="8" Grid.Column="1" Text="-" FontSize="9"/>
                                        <TextBlock Grid.Row="9" Text="User" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding LoggedInUserName}" FontSize="9"/>
                                        <TextBlock Grid.Row="10" Text="Gen. Date" FontWeight="Bold" FontSize="9"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding DocumentGeneratedDateDisplay}" FontSize="9"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" BorderBrush="#111827" BorderThickness="1"
                                      GridLinesVisibility="All" HorizontalGridLinesBrush="#111827" VerticalGridLinesBrush="#111827"
                                      HeadersVisibility="Column" FontSize="8" MinHeight="410">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCodeDisplay}" Width="45"/>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ProductName}" Width="120"/>
                                    <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="60"/>
                                    <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDateDisplay}" Width="62"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding PackageQuantity}" Width="50"/>
                                    <DataGridTextColumn Header="Bonus" Binding="{Binding BonusQuantity}" Width="38"/>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding PurchasePrice, StringFormat='{}{0:N2}'}" Width="50"/>
                                    <DataGridTextColumn Header="Gross" Binding="{Binding GrossLineAmount, StringFormat='{}{0:N2}'}" Width="58"/>
                                    <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat='{}{0:N2}'}" Width="45"/>
                                    <DataGridTextColumn Header="Disc Amount" Binding="{Binding DiscountAmount, StringFormat='{}{0:N2}'}" Width="62"/>
                                    <DataGridTextColumn Header="Adv Tax Amount" Binding="{Binding AdvTaxAmount, StringFormat='{}{0:N2}'}" Width="66"/>
                                    <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, StringFormat='{}{0:N2}'}" Width="58"/>
                                    <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat='{}{0:N2}'}" Width="66"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border BorderBrush="#111827" BorderThickness="1,0,1,1" Padding="8,5">
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Text="{Binding DocumentTotalItems, StringFormat='Total Items: {0}'}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DocumentTotalQuantity, StringFormat='Total Quantity: {0}'}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DocumentNetTotal, StringFormat='Page Total: Rs. {0:N2}'}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,310">
                                <TextBlock Grid.Column="0" Text="Received by: ____________________        Checked by: ____________________" FontSize="9" Foreground="#111827" VerticalAlignment="Top"/>
                                <Border Grid.Column="1" BorderBrush="#111827" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gross Amount (Base Total):" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding DocumentGrossAmount, StringFormat='Rs. {0:N2}'}" FontSize="10"/></Grid>
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Discount Amount:" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding DocumentDiscountAmount, StringFormat='Rs. {0:N2}'}" FontSize="10"/></Grid>
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Advance WHTax 236H @0.50%:" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding DocumentAdvanceWHTax, StringFormat='Rs. {0:N2}'}" FontSize="10"/></Grid>
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sub Total:" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding DocumentSubTotal, StringFormat='Rs. {0:N2}'}" FontSize="10"/></Grid>
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CN Value:" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding DocumentCNValue, StringFormat='Rs. {0:N2}'}" FontSize="10"/></Grid>
                                        <Separator Background="#111827"/>
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Net Grand Total (Final):" FontSize="12" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding DocumentNetTotal, StringFormat='Rs. {0:N2}'}" FontSize="12" FontWeight="Bold"/></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border BorderBrush="#111827" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Being a person resident in Pakistan carrying on business at the address shown above under the name of Al Mustafa Distribution Pvt Ltd do hereby give this warranty that the drugs invoice as sold by us, do not contravene in any way the provisions of section 18 of the Drug Act 1976." TextWrapping="Wrap" FontSize="9" Foreground="#111827"/>
                                    <TextBlock Text="Expiry items must be informed 6 months prior to expiry. Any discrepancy please inform us immediately." TextWrapping="Wrap" FontSize="9" FontWeight="Bold" Foreground="#111827"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Body (Full-width view for inputs & line items) -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsViewingInvoiceDocument}">
                <Grid RowDefinitions="Auto,Auto" Margin="28,24">
                
                <!-- Top panel: Inputs & Add Line Item -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,24">
                    
                    <!-- Left: Invoice Header -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="24" Margin="0,0,12,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="INVOICE HEADER" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <Separator/>
                            <Border Background="{DynamicResource BrushBlue50}" CornerRadius="8" Padding="10">
                                <TextBlock Text="{Binding LoggedInUserName, StringFormat='Recorded by: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                            </Border>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="Invoice Number" Classes="label"/>
                                    <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="{Binding !SaveCancelEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,12">
                                    <TextBlock Text="Date" Classes="label"/>
                                    <DatePicker SelectedDate="{Binding PurchaseDate}" IsEnabled="{Binding SaveCancelEnabled}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="Supplier (Optional)" Classes="label"/>
                                    <comp:SearchableComboBoxControl ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                              Text="{Binding SupplierSearchText}"
                                              AllowCustomText="True"
                                              IsEnabled="{Binding SaveCancelEnabled}" DisplayMemberPath="Name" DetailMemberPath="SCode" Placeholder="Search supplier..."/>
                                    <Button Command="{Binding QuickAddSupplierCommand}" Content="Add Supplier" Classes="btn-secondary" HorizontalAlignment="Left" IsVisible="{Binding SaveCancelEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                    <TextBlock Text="Supplier Name" Classes="label"/>
                                    <TextBox Text="{Binding SupplierName}" IsEnabled="{Binding SaveCancelEnabled}" PlaceholderText="Type supplier if not listed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Add Line Item -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="24" Margin="12,0,0,0">
                        <StackPanel Spacing="16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="ADD LINE ITEM" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                           FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, StringFormat='Net Grand Total (Final): Rs. {0:N2}'}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryBlue}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Separator/>
                            
                            <!-- Add line items (only visible when in Add mode) -->
                            <StackPanel Spacing="12" IsVisible="{Binding SaveCancelEnabled}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                        <TextBlock Text="Product *" Classes="label"/>
                                        <comp:SearchableComboBoxControl ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                            DisplayMemberPath="Name" DetailMemberPath="PurchasePrice" Placeholder="Search product..."/>
                                        <Button Command="{Binding QuickAddProductCommand}" Content="Add Product" Classes="btn-secondary" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                                        <Button  Command="{Binding AddLineItemCommand}" Classes="btn-secondary" Width="80">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
        <TextBlock Text="Add" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,12">
                                        <TextBlock Text="Batch Number (Optional)" Classes="label"/>
                                        <TextBox Text="{Binding BatchNumber}" PlaceholderText="Batch No. (optional)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,12">
                                        <TextBlock Text="Expiry Date" Classes="label"/>
                                        <DatePicker SelectedDate="{Binding ExpiryDate}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Qty / Packaging" Classes="label"/>
                                        <NumericUpDown Value="{Binding Quantity}" Minimum="1" FormatString="N0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,8,0">
                                        <TextBlock Text="Bonus" Classes="label"/>
                                        <NumericUpDown Value="{Binding BonusQuantity}" Minimum="0" FormatString="N0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Rate" Classes="label" ToolTip.Tip="Manual supplier trade cost for this invoice line."/>
                                        <NumericUpDown Value="{Binding PurchasePrice}" FormatString="N2" Minimum="0" ToolTip.Tip="Manual supplier trade cost for this invoice line."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="MRP (Retail Price)" Classes="label" ToolTip.Tip="Maximum Retail Price printed on box (used for patient billing)."/>
                                        <NumericUpDown Value="{Binding PackMRP}" FormatString="N2" Minimum="0" ToolTip.Tip="Maximum Retail Price printed on box (used for patient billing)."/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Extra Discount (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ExtraDiscount}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,8,0">
                                        <TextBlock Text="Advance Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ATax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="Company Sales Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding CompanySalesTax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="{DynamicResource BrushTeal50}" CornerRadius="8" Padding="12">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Gross Amount (Base Total)" FontSize="11" Foreground="{DynamicResource BrushInk500}" ToolTip.Tip="Base total before discounts and taxes (Qty × Rate)."/>
                                            <TextBlock Text="{Binding LineGrossAmountPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTeal}" ToolTip.Tip="Base total before discounts and taxes (Qty × Rate)."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Tax Total" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineTaxTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAmber}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Net Grand Total (Final)" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineNetTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- If not SaveCancelEnabled, show grand total big -->
                            <StackPanel Spacing="12" IsVisible="{Binding !SaveCancelEnabled}" VerticalAlignment="Center" Margin="0,32,0,0">
                                <TextBlock Text="Invoice Viewed" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk400}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cannot edit line items of an existing invoice." FontSize="13" Foreground="{DynamicResource BrushInk500}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom panel: Invoice Line items list -->
                <Grid Grid.Row="1">
                    <comp:DataTableShellControl Title="Invoice Items" RecordCount="{Binding LineItems.Count}">
                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=\{0:dd MMM yyyy\}}" Width="120"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding PackageQuantity}" Width="80"/>
                                    <DataGridTextColumn Header="BONUS" Binding="{Binding BonusQuantity}" Width="70"/>
                                    <DataGridTextColumn Header="RATE" Binding="{Binding PurchasePrice, StringFormat='Rs. {0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="MRP (RETAIL)" Binding="{Binding PackMRP, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTextColumn Header="DISC (%)" Binding="{Binding ExtraDiscount}" Width="90"/>
                                    <DataGridTextColumn Header="SUB TOTAL" Binding="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTextColumn Header="ADV. TAX (%)" Binding="{Binding ATax}" Width="100"/>
                                    <DataGridTextColumn Header="C.S.TAX (%)" Binding="{Binding CompanySalesTax}" Width="100"/>
                                    <DataGridTextColumn Header="NET AMOUNT" Binding="{Binding LineNetTotal, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTemplateColumn Width="60" IsVisible="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).SaveCancelEnabled}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).RemoveLineItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource BrushRose}"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </Grid>
            </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Classes="btn-secondary">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Command="{Binding SaveCommand}" Classes="btn-ghost" IsVisible="{Binding SaveCancelEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
                                <TextBlock Text="Save Draft" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditDraftCommand}" Classes="btn-ghost" Content="Edit Draft" IsVisible="{Binding CanEditDraft}"/>
                        <Button Command="{Binding EditCheckedInvoiceCommand}" Classes="btn-ghost" Content="Edit Draft" IsVisible="{Binding IsCheckingInvoice}"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushRose}"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="POSTED" IsVisible="{Binding IsPostedInvoice}" FontWeight="Bold" Foreground="{DynamicResource BrushTeal}" VerticalAlignment="Center"/>
                        <Button Command="{Binding PostInvoiceCommand}" Classes="btn-primary" IsVisible="{Binding !IsPostedInvoice}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Download" Width="18" Height="18"/>
                                <TextBlock Text="Post Purchase Invoice" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk600}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource BrushRose}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BE123C"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.40"/>
        </Style>
    </UserControl.Styles>
</UserControl>
