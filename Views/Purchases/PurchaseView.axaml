<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicSystem.UI.ViewModels.Purchases"
             xmlns:models="using:ClinicSystem.Core.Models"
             xmlns:comp="using:ClinicSystem.UI.Views.Components"
             x:Class="ClinicSystem.UI.Views.Purchases.PurchaseView"
             x:DataType="vm:PurchaseViewModel" x:CompileBindings="True"
             Background="{DynamicResource BrushBackground}">

    <Grid>
        <!-- ============================================================ -->
        <!-- 1. LIST/GRID VIEW (ShowForm is false)                         -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding !ShowForm}" RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Purchase Invoices" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Create and view purchase invoices from suppliers"
                                       FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button  Command="{Binding NewCommand}"
                            Classes="btn-primary" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
        <TextBlock Text="New Purchase" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                </DockPanel>
            </Border>

            <!-- Summary Cards Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="28,16,28,4">
                <comp:SummaryCardControl Grid.Column="0" Margin="0,0,12,0"
                    Title="Total Invoices"
                    Value="{Binding TotalInvoicesCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushPrimaryBlue}"/>
                <comp:SummaryCardControl Grid.Column="1" Margin="0,0,12,0"
                    Title="Purchases Amount"
                    Value="{Binding TotalPurchasesAmount, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushTeal}"/>
                <comp:SummaryCardControl Grid.Column="2" Margin="0,0,12,0"
                    Title="Total Suppliers"
                    Value="{Binding TotalSuppliersCount, StringFormat={}{0}}"
                    BorderColor="{DynamicResource BrushAmber}"/>
                <comp:SummaryCardControl Grid.Column="3"
                    Title="Avg Invoice Value"
                    Value="{Binding AverageInvoiceValue, StringFormat='Rs. {0:N2}'}"
                    BorderColor="{DynamicResource BrushRose}"/>
            </Grid>

            <!-- Data Panel -->
            <Grid Grid.Row="2" Margin="28,12,28,24">
                <comp:DataTableShellControl Title="Purchase History" RecordCount="{Binding Purchases.Count}">
                    <comp:DataTableShellControl.FilterToolbar>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button  Command="{Binding ViewDetailsCommand}"
                                    IsEnabled="{Binding SelectedPurchase, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Classes="btn-secondary">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Eye" Width="18" Height="18"/>
        <TextBlock Text="View Details" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        </StackPanel>
                    </comp:DataTableShellControl.FilterToolbar>
                    <comp:DataTableShellControl.TableContent>
                        <DataGrid ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE NO." Binding="{Binding InvoiceNumber}" Width="200"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat=\{0:dd MMM yyyy\}}" Width="180"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="CREATED BY" Binding="{Binding CreatedByName}" Width="150"/>
                                <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </comp:DataTableShellControl.TableContent>
                </comp:DataTableShellControl>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 2. FORM / DETAIL VIEW (ShowForm is true)                     -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding ShowForm}" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushBlue50}">
                            <materialIcons:MaterialIcon Kind="Cart" Width="20" Height="20"
                                      Foreground="{DynamicResource BrushPrimaryBlue}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Mode, StringFormat='{}{0} Purchase Invoice'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk900}" FontFamily="{DynamicResource FontLexend}"/>
                            <TextBlock Text="Enter details and items for this invoice" FontSize="12" Foreground="{DynamicResource BrushInk600}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Printable document view -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsViewingInvoiceDocument}">
                <StackPanel Margin="28,24" Spacing="18">
                    <Border Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Button Command="{Binding CancelCommand}" Classes="btn-secondary" DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
                                    <TextBlock Text="Back to List"/>
                                </StackPanel>
                            </Button>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Command="{Binding PrintPurchaseDocumentCommand}" Classes="btn-primary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                        <TextBlock Text="Print / Export PDF"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding EmailPurchaseDocumentCommand}" Classes="btn-secondary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18"/>
                                        <TextBlock Text="Email Document"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Width="800" MinHeight="1120" HorizontalAlignment="Center"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="0" Padding="40,48" BoxShadow="0 8 24 0 #18000000">
                        <StackPanel Spacing="28">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="48" Height="48" CornerRadius="8" Background="#EFF6FF">
                                            <materialIcons:MaterialIcon Kind="HospitalBuilding" Width="24" Height="24"
                                                Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="MediCompare Clinic &amp; Pharmacy" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                                            <TextBlock Text="Purchase and inventory document" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock Text="PURCHASE INVOICE" FontSize="24" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='Invoice No: {0}'}" FontSize="13" Foreground="#374151" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding PurchaseDate, StringFormat='Date: {0:dd MMM yyyy}'}" FontSize="13" Foreground="#374151" HorizontalAlignment="Right"/>
                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DocumentStatus}" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                    </Border>
                                    <TextBlock Text="{Binding LoggedInUserName, StringFormat='Processed by: {0}'}" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="18">
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="SUPPLIER DETAILS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding SupplierDisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                                        <TextBlock Text="Purchase supplier record" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                        <TextBlock Text="INVOICE META INFORMATION" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding LineItems.Count, StringFormat='Line items: {0}'}" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding PurchaseItemID}" Width="48"/>
                                    <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="BATCH / EXPIRY" Binding="{Binding BatchExpiryDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="QTY / PIECES" Binding="{Binding PackageQuantity}" Width="100"/>
                                    <DataGridTextColumn Header="UNIT RATE / T.P / MRP" Binding="{Binding RateMrpDisplay}" Width="150"/>
                                    <DataGridTextColumn Header="TAX / DISCOUNT" Binding="{Binding TaxDiscountDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding LineNetTotal, StringFormat='Rs. {0:N2}'}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid ColumnDefinitions="*,300">
                                <TextBlock Grid.Column="0" Text="Posted purchase invoices are retained for stock and audit history."
                                           Foreground="#6B7280" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Sub Total" Foreground="#374151"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DocumentSubTotal, StringFormat='Rs. {0:N2}'}" Foreground="#111827"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Taxes &amp; Discounts" Foreground="#374151"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DocumentAdjustmentsTotal, StringFormat='Rs. {0:N2}'}" Foreground="#111827"/>
                                    </Grid>
                                    <Separator Background="#D1D5DB"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Grand Total" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='Rs. {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Body (Full-width view for inputs & line items) -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsViewingInvoiceDocument}">
                <Grid RowDefinitions="Auto,Auto" Margin="28,24">
                
                <!-- Top panel: Inputs & Add Line Item -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,24">
                    
                    <!-- Left: Invoice Header -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="24" Margin="0,0,12,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="INVOICE HEADER" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                       FontFamily="{DynamicResource FontLexend}"/>
                            <Separator/>
                            <Border Background="{DynamicResource BrushBlue50}" CornerRadius="8" Padding="10">
                                <TextBlock Text="{Binding LoggedInUserName, StringFormat='Recorded by: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                            </Border>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,12">
                                    <TextBlock Text="Invoice Number" Classes="label"/>
                                    <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="{Binding !SaveCancelEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,12">
                                    <TextBlock Text="Date" Classes="label"/>
                                    <DatePicker SelectedDate="{Binding PurchaseDate}" IsEnabled="{Binding SaveCancelEnabled}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="Supplier (Optional)" Classes="label"/>
                                    <comp:SearchableComboBoxControl ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                              Text="{Binding SupplierSearchText}"
                                              AllowCustomText="True"
                                              IsEnabled="{Binding SaveCancelEnabled}" DisplayMemberPath="Name" DetailMemberPath="SCode" Placeholder="Search supplier..."/>
                                    <Button Command="{Binding QuickAddSupplierCommand}" Content="Add Supplier" Classes="btn-secondary" HorizontalAlignment="Left" IsVisible="{Binding SaveCancelEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                    <TextBlock Text="Supplier Name" Classes="label"/>
                                    <TextBox Text="{Binding SupplierName}" IsEnabled="{Binding SaveCancelEnabled}" PlaceholderText="Type supplier if not listed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Add Line Item -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}"
                            BorderBrush="{DynamicResource BrushLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusCard}" Padding="24" Margin="12,0,0,0">
                        <StackPanel Spacing="16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="ADD LINE ITEM" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushInk400}" LetterSpacing="1.5"
                                           FontFamily="{DynamicResource FontLexend}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotal, StringFormat='Grand Total: Rs. {0:N2}'}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryBlue}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Separator/>
                            
                            <!-- Add line items (only visible when in Add mode) -->
                            <StackPanel Spacing="12" IsVisible="{Binding SaveCancelEnabled}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                        <TextBlock Text="Product *" Classes="label"/>
                                        <comp:SearchableComboBoxControl ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                            DisplayMemberPath="Name" DetailMemberPath="PurchasePrice" Placeholder="Search product..."/>
                                        <Button Command="{Binding QuickAddProductCommand}" Content="Add Product" Classes="btn-secondary" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                                        <Button  Command="{Binding AddLineItemCommand}" Classes="btn-secondary" Width="80">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
        <TextBlock Text="Add" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,12">
                                        <TextBlock Text="Batch Number (Optional)" Classes="label"/>
                                        <TextBox Text="{Binding BatchNumber}" PlaceholderText="Batch No. (optional)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,12">
                                        <TextBlock Text="Expiry Date" Classes="label"/>
                                        <DatePicker SelectedDate="{Binding ExpiryDate}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Qty / Packaging" Classes="label"/>
                                        <NumericUpDown Value="{Binding Quantity}" Minimum="1" FormatString="N0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,8,0">
                                        <TextBlock Text="Bonus" Classes="label"/>
                                        <NumericUpDown Value="{Binding BonusQuantity}" Minimum="0" FormatString="N0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="T.P" Classes="label"/>
                                        <NumericUpDown Value="{Binding PurchasePrice}" FormatString="N2" Minimum="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="MRP" Classes="label"/>
                                        <NumericUpDown Value="{Binding PackMRP}" FormatString="N2" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Extra Discount (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ExtraDiscount}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,8,0">
                                        <TextBlock Text="Advance Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding ATax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="Company Sales Tax (%)" Classes="label"/>
                                        <NumericUpDown Value="{Binding CompanySalesTax}" Minimum="0" Maximum="100" FormatString="N2"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="{DynamicResource BrushTeal50}" CornerRadius="8" Padding="12">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Sub Total" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineSubTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTeal}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Tax Total" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineTaxTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAmber}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Net Total" FontSize="11" Foreground="{DynamicResource BrushInk500}"/>
                                            <TextBlock Text="{Binding LineNetTotalPreview, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimaryBlue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- If not SaveCancelEnabled, show grand total big -->
                            <StackPanel Spacing="12" IsVisible="{Binding !SaveCancelEnabled}" VerticalAlignment="Center" Margin="0,32,0,0">
                                <TextBlock Text="Invoice Viewed" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk400}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cannot edit line items of an existing invoice." FontSize="13" Foreground="{DynamicResource BrushInk500}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom panel: Invoice Line items list -->
                <Grid Grid.Row="1">
                    <comp:DataTableShellControl Title="Invoice Items" RecordCount="{Binding LineItems.Count}">
                        <comp:DataTableShellControl.TableContent>
                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=\{0:dd MMM yyyy\}}" Width="120"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding PackageQuantity}" Width="80"/>
                                    <DataGridTextColumn Header="BONUS" Binding="{Binding BonusQuantity}" Width="70"/>
                                    <DataGridTextColumn Header="T.P" Binding="{Binding PurchasePrice, StringFormat='Rs. {0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="MRP" Binding="{Binding PackMRP, StringFormat='Rs. {0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="DISC (%)" Binding="{Binding ExtraDiscount}" Width="90"/>
                                    <DataGridTextColumn Header="SUB TOTAL" Binding="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTextColumn Header="ADV. TAX (%)" Binding="{Binding ATax}" Width="100"/>
                                    <DataGridTextColumn Header="C.S.TAX (%)" Binding="{Binding CompanySalesTax}" Width="100"/>
                                    <DataGridTextColumn Header="NET TOTAL" Binding="{Binding LineNetTotal, StringFormat='Rs. {0:N2}'}" Width="120"/>
                                    <DataGridTemplateColumn Width="60" IsVisible="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).SaveCancelEnabled}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding $parent[UserControl].((vm:PurchaseViewModel)DataContext).RemoveLineItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource BrushRose}"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </comp:DataTableShellControl.TableContent>
                    </comp:DataTableShellControl>
                </Grid>
            </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="28,16">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushRose}"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button  Command="{Binding CancelCommand}" Classes="btn-secondary">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"/>
        <TextBlock Text="Back" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        <Button  Command="{Binding SaveCommand}" Classes="btn-ghost" IsVisible="{Binding SaveCancelEnabled}">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
        <TextBlock Text="Save Draft" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        <TextBlock Text="POSTED" IsVisible="{Binding IsPostedInvoice}" FontWeight="Bold" Foreground="{DynamicResource BrushTeal}" VerticalAlignment="Center"/>
                        <Button Command="{Binding EditDraftCommand}" Classes="btn-ghost" Content="Edit Draft" IsVisible="{Binding CanEditDraft}"/>
                        <Button Command="{Binding EditCheckedInvoiceCommand}" Classes="btn-ghost" Content="Edit Draft" IsVisible="{Binding IsCheckingInvoice}"/>
                        <Button Command="{Binding CheckInvoiceCommand}" Classes="btn-ghost" Content="Check Invoice" IsVisible="{Binding CanCheckInvoice}"/>
                        <Button Command="{Binding PostAndAddAnotherCommand}" Classes="btn-ghost" Content="Post &amp; Add Another" IsVisible="{Binding IsCheckingInvoice}"/>
                        <Button  Command="{Binding SaveAndCheckCommand}" Classes="btn-primary" IsVisible="{Binding SaveCancelEnabled}">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18"/>
        <TextBlock Text="Save &amp; Check Invoice" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                        <Button Command="{Binding PostInvoiceCommand}" Classes="btn-primary" Content="Post Invoice" IsVisible="{Binding IsCheckingInvoice}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk600}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource BrushRose}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BE123C"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.40"/>
        </Style>
    </UserControl.Styles>
</UserControl>
